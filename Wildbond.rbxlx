  <Item class="StarterPlayer" referent="15">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CharacterJumpHeight">7.2</float>
      <float name="CharacterWalkSpeed">20</float>
      <bool name="EnableMouseLockOption">false</bool>
    </Properties>
    <Item class="StarterCharacterScripts" referent="16">
      <Properties>
        <string name="Name">StarterCharacterScripts</string>
      </Properties>
      <Item class="Script" referent="17">
        <Properties>
          <string name="Name">Health</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Disable Roblox's default passive regeneration. Hunts start with full health;
-- completing a hunt or respawning restores it. Damage matters during combat.
]]></string>
