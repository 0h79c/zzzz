    <Item class="StarterPlayerScripts" referent="18">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="19">
        <Properties>
          <string name="Name">WildbondClient</string>
          <string name="Source"><![CDATA[--!nonstrict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local shared = ReplicatedStorage:WaitForChild("Wildbond")
local Expedition = require(shared:WaitForChild("Expedition"))
local CombatRules = require(shared:WaitForChild("CombatRules"))
local DodgeRules = require(shared:WaitForChild("DodgeRules"))
local PetRules = require(shared:WaitForChild("PetRules"))
local Hud = require(script:WaitForChild("Hud"))
local CompanionView = require(script:WaitForChild("CompanionView"))
local EnemyView = require(script:WaitForChild("EnemyView"))
local PlayerCombatView = require(script:WaitForChild("PlayerCombatView"))
local remotes = shared:WaitForChild("Remotes")
local command = remotes:WaitForChild("Command")
local update = remotes:WaitForChild("Update")
local effect = remotes:WaitForChild("Effect")

local hud = Hud.start(command, Expedition.pets, CombatRules, DodgeRules)
local stopCompanion, animateBond = CompanionView.start(Players.LocalPlayer)
local stopEnemies = EnemyView.start()
local stopPlayer, animateMelee, animateDodge = PlayerCombatView.start(Players.LocalPlayer, DodgeRules)
local connection = update.OnClientEvent:Connect(function(state, message, success)
	hud:render(state, message, success)
end)
local effectConnection = effect.OnClientEvent:Connect(function(kind, position, hit)
	if kind == "bond" and typeof(position) == "Vector3" then
		animateBond(position)
		hud:bondAccepted(PetRules.skillCooldown)
	elseif kind == "melee" and typeof(position) == "Vector3" then
		animateMelee(position, hit == true, if hit == true then CombatRules.meleeDamage else 0)
		hud:meleeAccepted(CombatRules.meleeCooldown)
	elseif kind == "dodge" and typeof(position) == "Vector3" then
		animateDodge(position)
		hud:dodgeAccepted(DodgeRules.cooldown)
	end
end)
command:FireServer("sync")

script.Destroying:Connect(function()
	connection:Disconnect()
	effectConnection:Disconnect()
	stopCompanion()
	stopEnemies()
	stopPlayer()
	hud:destroy()
end)
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">CompanionView</string>
            <string name="Source"><![CDATA[--!strict
-- Pet positions, health and actions come from the server. These anchored parts
-- articulate the replicated actor and never select or damage foes.
local RunService = game:GetService("RunService")
local CompanionView = {}

type Piece = { part: BasePart, offset: CFrame, phase: number?, role: string }
type Pet = {
	actor: Model, visual: Model, pieces: { Piece }, petId: string?, frame: CFrame?, phase: number,
	state: string, changedAt: number, label: TextLabel?, fill: Frame?, billboard: BillboardGui?,
}
type FolderWatch = { active: boolean, connections: { RBXScriptConnection } }
local names: { [string]: string } = { mosswolf = "Moss Wolf", emberfox = "Ember Fox", tidecub = "Tide Cub" }

local function disconnect(connections: { RBXScriptConnection })
	for _, connection in connections do connection:Disconnect() end
	table.clear(connections)
end

local function piece(pet: Pet, name: string, size: Vector3, offset: CFrame, color: Color3, role: string?, phase: number?, wedge: boolean?): BasePart
	local part = (if wedge then Instance.new("WedgePart") else Instance.new("Part")) :: BasePart
	part.Name, part.Size, part.Color, part.Material = name, size, color, Enum.Material.SmoothPlastic
	part.Anchored, part.CanCollide, part.CanTouch, part.CanQuery = true, false, false, false
	part.Parent = pet.visual
	table.insert(pet.pieces, { part = part, offset = offset, phase = phase, role = role or "body" })
	return part
end

local function build(pet: Pet, petId: string, localOwner: boolean)
	pet.visual:ClearAllChildren()
	table.clear(pet.pieces)
	pet.petId = petId
	pet.visual:SetAttribute("PetId", petId)
	pet.visual:SetAttribute("OwnerUserId", pet.actor:GetAttribute("OwnerUserId"))
	local fox, cub = petId == "emberfox", petId == "tidecub"
	local fur = if fox then Color3.fromRGB(196, 115, 67) elseif cub then Color3.fromRGB(129, 180, 197) else Color3.fromRGB(222, 230, 220)
	local shadow = if fox then Color3.fromRGB(89, 70, 65) elseif cub then Color3.fromRGB(104, 146, 169) else Color3.fromRGB(176, 192, 189)
	local cream = if fox then Color3.fromRGB(238, 219, 177) else shadow
	local accent = if fox then Color3.fromRGB(239, 205, 133) elseif cub then Color3.fromRGB(178, 210, 221) else Color3.fromRGB(139, 174, 116)
	local body = piece(pet, "Body", if cub then Vector3.new(1.5, 1.1, 1.6) else Vector3.new(1.25, 0.95, 2), CFrame.identity, fur)
	pet.visual.PrimaryPart = body
	piece(pet, "ChestRuff", if cub then Vector3.new(1.4, 1.05, 0.7) else Vector3.new(1.4, 1.12, 0.8), CFrame.new(0, 0.1, -0.7) * CFrame.Angles(math.rad(-8), 0, 0), if fox then cream else fur)
	piece(pet, "Head", if cub then Vector3.new(1.2, 0.95, 0.9) else Vector3.new(0.95, 0.85, 0.95), CFrame.new(0, 0.45, -1.25), fur, "head")
	piece(pet, "Muzzle", if cub then Vector3.new(0.72, 0.32, 0.4) else Vector3.new(0.65, 0.32, 0.65), CFrame.new(0, 0.28, if cub then -1.78 else -1.92), cream, "head")
	piece(pet, "Jaw", if cub then Vector3.new(0.63, 0.18, 0.45) else Vector3.new(0.56, 0.18, 0.7), CFrame.new(0, 0.06, if cub then -1.77 else -1.91), shadow, "jaw")
	piece(pet, "Nose", Vector3.new(0.25, 0.2, 0.16), CFrame.new(0, 0.32, if cub then -2.02 else -2.29), Color3.fromRGB(43, 54, 57), "head")
	for _, side in { -1, 1 } do
		local ear = piece(pet, "Ear", if fox then Vector3.new(0.45, 0.95, 0.42) elseif cub then Vector3.new(0.46, 0.46, 0.4) else Vector3.new(0.32, 0.68, 0.4), CFrame.new(side * (if cub then 0.5 else 0.34), if fox then 1.15 else 1.05, -1.15) * CFrame.Angles(0, 0, math.rad(-side * 12)), shadow, "head", nil, not cub)
		if cub and ear:IsA("Part") then ear.Shape = Enum.PartType.Ball end
		piece(pet, "Eye", Vector3.new(0.08, 0.13, 0.17), CFrame.new(side * (if cub then 0.61 else 0.48), 0.53, -1.56), Color3.fromRGB(47, 72, 83), "head")
		for _, z in { -0.63, 0.7 } do
			local phase = if (side == -1 and z < 0) or (side == 1 and z > 0) then 0 else math.pi
			piece(pet, "Leg", if cub then Vector3.new(0.43, 0.77, 0.45) else Vector3.new(0.32, 0.92, 0.38), CFrame.new(side * (if cub then 0.53 else 0.46), if cub then -0.96 else -0.84, z), shadow, if z < 0 then "frontLeg" else "backLeg", phase)
		end
	end
	piece(pet, "Tail", if fox then Vector3.new(0.68, 0.65, 1.6) elseif cub then Vector3.new(0.48, 0.45, 0.5) else Vector3.new(0.4, 0.42, 1.22), CFrame.new(0, 0.15, if cub then 1 else 1.37) * CFrame.Angles(math.rad(-23), 0, 0), fur, "tail")
	if fox then piece(pet, "FoxTailTip", Vector3.new(0.7, 0.67, 0.5), CFrame.new(0, 0.45, 2.08) * CFrame.Angles(math.rad(-23), 0, 0), cream, "tail") end
	piece(pet, "TrailScarf", Vector3.new(1.43, 0.26, 0.33), CFrame.new(0, 0.3, -0.9), accent)
	piece(pet, "ScarfKnot", Vector3.new(0.25, 0.6, 0.25), CFrame.new(0.64, 0.02, -0.97) * CFrame.Angles(0, 0, math.rad(-15)), accent)
	for index = 1, 6 do
		local spark = piece(pet, "SkillSpark", Vector3.new(0.16, 0.42, 0.16), CFrame.identity, accent, "spark", index * math.pi / 3)
		spark.Material, spark.Transparency = Enum.Material.Neon, 1
	end
	local billboard = Instance.new("BillboardGui")
	billboard.Name, billboard.Adornee = "PetHealth", body
	billboard.Size, billboard.StudsOffset = UDim2.fromOffset(170, 42), Vector3.new(0, 2.2, 0)
	billboard.AlwaysOnTop, billboard.MaxDistance, billboard.Parent = true, if localOwner then 85 else 55, pet.visual
	local label = Instance.new("TextLabel")
	label.Name, label.Size, label.BackgroundTransparency = "HealthLabel", UDim2.new(1, 0, 0, 25), 1
	label.Font, label.TextSize, label.TextColor3 = Enum.Font.GothamMedium, 12, Color3.fromRGB(244, 247, 237)
	label.TextStrokeColor3, label.TextStrokeTransparency, label.Parent = Color3.fromRGB(30, 44, 38), 0.35, billboard
	local bar = Instance.new("Frame")
	bar.Name, bar.Position, bar.Size = "HealthBar", UDim2.new(0.12, 0, 0, 28), UDim2.new(0.76, 0, 0, 5)
	bar.BackgroundColor3, bar.BorderSizePixel, bar.Parent = Color3.fromRGB(38, 48, 45), 0, billboard
	local fill = Instance.new("Frame")
	fill.Name, fill.Size, fill.BorderSizePixel = "Fill", UDim2.fromScale(1, 1), 0
	fill.BackgroundColor3, fill.Parent = if localOwner then Color3.fromRGB(140, 220, 159) else Color3.fromRGB(149, 195, 218), bar
	pet.billboard, pet.label, pet.fill = billboard, label, fill
end

local function animate(pet: Pet, dt: number, now: number, container: Folder, player: Player)
	local root, petId = pet.actor.PrimaryPart, pet.actor:GetAttribute("PetId")
	local owner = pet.actor:GetAttribute("OwnerUserId")
	local health, maxHealth = pet.actor:GetAttribute("Health"), pet.actor:GetAttribute("MaxHealth")
	if not root or not root:IsDescendantOf(pet.actor) or typeof(petId) ~= "string" or not names[petId]
		or typeof(owner) ~= "number" or typeof(health) ~= "number" or typeof(maxHealth) ~= "number" or maxHealth <= 0 then
		pet.visual.Parent, pet.frame = nil, nil
		return
	end
	if pet.petId ~= petId or pet.visual:GetAttribute("OwnerUserId") ~= owner then build(pet, petId, owner == player.UserId) end
	pet.visual.Parent = container
	local previous = pet.frame or root.CFrame
	local frame = if (previous.Position - root.CFrame.Position).Magnitude > 40 then root.CFrame
		else previous:Lerp(root.CFrame, 1 - math.exp(-math.min(dt, 0.1) * 16))
	local speed = ((frame.Position - previous.Position) * Vector3.new(1, 0, 1)).Magnitude / math.max(dt, 0.001)
	pet.frame = frame
	local serverState = pet.actor:GetAttribute("State")
	local state = if health == 0 then "Dead" elseif typeof(serverState) == "string" then serverState else "Follow"
	if state ~= pet.state then pet.state, pet.changedAt = state, now end
	local started, duration = pet.actor:GetAttribute("ActionStartedAt"), pet.actor:GetAttribute("ActionDuration")
	-- State and HP can arrive in separate replication updates. A premature
	-- Follow timestamp must not restart the death fade while HP is still zero.
	local actionStart = if state == "Dead" and serverState ~= "Dead" then pet.changedAt
		elseif typeof(started) == "number" then started else pet.changedAt
	local elapsed = now - actionStart
	local progress = math.clamp(elapsed / (if typeof(duration) == "number" and duration > 0 then duration else 0.5), 0, 1)
	local dead = if state == "Dead" then math.clamp(elapsed / 0.45, 0, 1) else 0
	local skill, attack = state == "Skill", state == "Attack"
	local windup = if attack or skill then math.clamp(progress / 0.3, 0, 1) * (1 - math.clamp((progress - 0.3) / 0.16, 0, 1)) else 0
	local strike = if attack or skill then math.sin(math.clamp((progress - 0.3) / 0.7, 0, 1) * math.pi) else 0
	local target = pet.actor:GetAttribute("AttackTarget")
	if (attack or skill) and typeof(target) == "Vector3" then
		local direction = (target - frame.Position) * Vector3.new(1, 0, 1)
		if direction.Magnitude > 0.01 then frame = CFrame.lookAt(frame.Position, frame.Position + direction.Unit) end
	end
	local gait = if state == "Follow" then math.clamp(speed / 16, 0, 1) else 0
	pet.phase += math.min(dt, 0.1) * (5 + math.min(speed, 22))
	local bob = math.sin(pet.phase * 2) * 0.045 * gait
	local lift = if skill then strike * 0.85 elseif attack then strike * 0.22 else 0
	local pose = frame * CFrame.new(0, bob + lift - dead * 0.9, windup * 0.18 - strike * (if skill then 1.1 else 0.5))
		* CFrame.Angles(windup * 0.08 - strike * 0.1, 0, dead * 1.1)
	for _, item in pet.pieces do
		local offset = item.offset
		if item.role == "spark" then
			local angle = (item.phase or 0) + progress * math.pi * 2
			offset = CFrame.new(math.cos(angle) * (1.2 + strike * 0.5), 0.2 + strike * 0.7, math.sin(angle) * 1.7)
				* CFrame.Angles(0.4, angle, -0.6)
			item.part.Transparency = if skill and progress > 0 and progress < 1 then 0.15 + 0.85 * (1 - strike) else 1
		elseif item.phase then
			local swing = math.sin(pet.phase + item.phase) * 0.35 * gait
			if item.role == "frontLeg" then swing += windup * 0.18 - strike * (if skill then 0.7 else 0.25)
			else swing += strike * 0.28 end
			local hip = Vector3.new(offset.X, -0.38, offset.Z)
			offset = CFrame.new(hip) * CFrame.Angles(swing, 0, 0) * CFrame.new(-hip) * offset
		elseif item.role == "head" or item.role == "jaw" then
			local neck = Vector3.new(0, 0.3, -0.85)
			offset = CFrame.new(neck) * CFrame.Angles(-windup * 0.16 + strike * 0.2, 0, 0) * CFrame.new(-neck) * offset
			if item.role == "jaw" then
				local hinge = Vector3.new(0, 0.13, -1.55)
				offset = CFrame.new(hinge) * CFrame.Angles(-(windup * 0.42 + strike * 0.16), 0, 0) * CFrame.new(-hinge) * offset
			end
		elseif item.role == "tail" then
			offset *= CFrame.Angles(0, math.sin(pet.phase * 0.55) * 0.09 * (1 - strike), windup * 0.14)
		end
		if item.role ~= "spark" then item.part.Transparency = dead end
		item.part.CFrame = pose * offset
	end
	local billboard, label, fill = pet.billboard, pet.label, pet.fill
	if billboard and label and fill then
		billboard.Enabled = state ~= "Dead" and typeof(health) == "number" and typeof(maxHealth) == "number" and maxHealth > 0
		if typeof(health) == "number" and typeof(maxHealth) == "number" and maxHealth > 0 then
			label.Text = string.format("%s  %d / %d", names[petId], math.ceil(math.max(0, health)), math.ceil(maxHealth))
			fill.Size = UDim2.fromScale(math.clamp(health / maxHealth, 0, 1), 1)
		end
	end
end

function CompanionView.start(player: Player): (() -> (), (Vector3) -> ())
	local container = Instance.new("Folder")
	container.Name, container.Parent = "LocalCompanionVisuals", workspace
	container:SetAttribute("CosmeticOnly", true)
	local pets: { [Model]: Pet } = {}
	local folders: { [Instance]: FolderWatch } = {}
	local stopped = false
	local function removePet(item: Instance)
		if not item:IsA("Model") then return end
		local pet = pets[item]
		if not pet then return end
		pet.visual:Destroy()
		pets[item] = nil
	end
	local function addPet(item: Instance)
		if stopped or not item:IsA("Model") or pets[item] then return end
		local visual = Instance.new("Model")
		visual.Name, visual.Parent = item.Name, container
		visual:SetAttribute("CosmeticOnly", true)
		pets[item] = { actor = item, visual = visual, pieces = {}, petId = nil, frame = nil, phase = 0, state = "", changedAt = 0,
			label = nil, fill = nil, billboard = nil }
	end
	local function detach(folder: Instance, watch: FolderWatch)
		for _, child in folder:GetChildren() do removePet(child) end
		for model in pets do if model.Parent == folder then removePet(model) end end
		for index = #watch.connections, 2, -1 do watch.connections[index]:Disconnect(); table.remove(watch.connections, index) end
		watch.active = false
	end
	local function refreshFolder(folder: Instance, watch: FolderWatch)
		local active = not stopped and folder.Parent == workspace and folder.Name == "WildbondCompanions"
		if watch.active and not active then detach(folder, watch) end
		if active and not watch.active then
			watch.active = true
			table.insert(watch.connections, folder.ChildAdded:Connect(addPet))
			table.insert(watch.connections, folder.ChildRemoved:Connect(removePet))
			for _, child in folder:GetChildren() do addPet(child) end
		end
	end
	local function watchFolder(folder: Instance)
		if stopped or folder == container or not folder:IsA("Folder") or folders[folder] then return end
		local watch: FolderWatch = { active = false, connections = {} }
		folders[folder] = watch
		table.insert(watch.connections, folder:GetPropertyChangedSignal("Name"):Connect(function() refreshFolder(folder, watch) end))
		refreshFolder(folder, watch)
	end
	local function removeFolder(folder: Instance)
		local watch = folders[folder]
		if not watch then return end
		if watch.active then detach(folder, watch) end
		disconnect(watch.connections)
		folders[folder] = nil
	end
	for _, folder in workspace:GetChildren() do watchFolder(folder) end
	local added, removed = workspace.ChildAdded:Connect(watchFolder), workspace.ChildRemoved:Connect(removeFolder)
	local render = RunService.RenderStepped:Connect(function(dt: number)
		local now = workspace:GetServerTimeNow()
		for model, pet in pets do
			local parent = model.Parent
			if parent and folders[parent] and folders[parent].active then animate(pet, dt, now, container, player)
			else removePet(model) end
		end
	end)
	local function cleanup()
		if stopped then return end
		stopped = true
		render:Disconnect(); added:Disconnect(); removed:Disconnect()
		for folder in folders do removeFolder(folder) end
		for model in pets do removePet(model) end
		container:Destroy()
	end
	-- The old manual Bond effect still calls this API. Replicated action timestamps
	-- drive its animation now, so the callback must not start a second pounce.
	local function strikeAt(_targetPosition: Vector3) end
	return cleanup, strikeAt
end

return CompanionView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">EnemyView</string>
            <string name="Source"><![CDATA[--!strict
-- Local articulation only; the original server geometry remains the hitbox.
local RunService = game:GetService("RunService")
local EnemyView = {}

type Piece = { source: BasePart, part: BasePart, offset: CFrame, size: Vector3, transparency: number, hidden: number }
type Enemy = {
	model: Model, visual: Model, pieces: { [BasePart]: Piece }, connections: { RBXScriptConnection },
	root: BasePart?, frame: CFrame?, dirty: boolean, phase: number, state: string, changedAt: number,
}
type FolderWatch = { active: boolean, connections: { RBXScriptConnection } }

local function disconnect(connections: { RBXScriptConnection })
	for _, connection in connections do connection:Disconnect() end
	table.clear(connections)
end

local function removePiece(enemy: Enemy, source: BasePart)
	local piece = enemy.pieces[source]
	if not piece then return end
	source.LocalTransparencyModifier = piece.hidden
	piece.part:Destroy()
	enemy.pieces[source] = nil
end

local function addPiece(enemy: Enemy, source: BasePart, root: BasePart)
	if enemy.pieces[source] then return end
	local clone = source:Clone()
	if not clone then return end
	-- Keep authored mesh/texture geometry, but never copy scripts, GUIs or joints.
	for _, child in clone:GetChildren() do
		if not (child:IsA("DataModelMesh") or child:IsA("SurfaceAppearance") or child:IsA("Decal")) then child:Destroy() end
	end
	clone.Anchored, clone.CanCollide, clone.CanQuery, clone.CanTouch = true, false, false, false
	clone.LocalTransparencyModifier = 0
	clone.Parent = enemy.visual
	enemy.pieces[source] = {
		source = source, part = clone, offset = root.CFrame:ToObjectSpace(source.CFrame), size = source.Size,
		transparency = source.Transparency, hidden = source.LocalTransparencyModifier,
	}
	source.LocalTransparencyModifier = 1
end

local function stateOf(model: Model): string
	local state = model:GetAttribute("State")
	if typeof(state) == "string" then return state end
	local status = model:GetAttribute("Status")
	if model:GetAttribute("Health") == 0 or status == "Defeated" or status == "Dead" then return "Dead" end
	if status == "Returning" then return "Return" end
	if status == "Windup" then return "SkillWindup" end
	return "Patrol"
end

local function animate(enemy: Enemy, dt: number, now: number, container: Folder)
	local root = enemy.model.PrimaryPart
	if not root or not root:IsDescendantOf(enemy.model) then
		enemy.visual.Parent = nil
		return
	end
	if enemy.root ~= root then
		for source in enemy.pieces do removePiece(enemy, source) end
		enemy.root, enemy.frame, enemy.dirty = root, nil, true
	end
	if enemy.dirty then
		enemy.dirty = false
		for _, item in enemy.model:GetDescendants() do
			if item:IsA("BasePart") then addPiece(enemy, item, root) end
		end
	end
	enemy.visual.Parent = container
	local previous = enemy.frame or root.CFrame
	local frame = if (previous.Position - root.Position).Magnitude > 40 then root.CFrame
		else previous:Lerp(root.CFrame, 1 - math.exp(-math.min(dt, 0.1) * 14))
	local speed = (frame.Position - previous.Position).Magnitude / math.max(dt, 0.001)
	enemy.frame = frame
	local state = stateOf(enemy.model)
	if state ~= enemy.state then enemy.state, enemy.changedAt = state, now end
	local started = enemy.model:GetAttribute("ActionStartedAt")
	local duration = enemy.model:GetAttribute("ActionDuration")
	local fallback = if state == "Dead" then 0.7 elseif state == "MeleeRecover" then 0.28 else 0.6
	local progress = math.clamp((now - (if typeof(started) == "number" then started else enemy.changedAt))
		/ (if typeof(duration) == "number" and duration > 0 then duration else fallback), 0, 1)
	local moving = state == "Patrol" or state == "Chase" or state == "Return"
	local gait = if moving then math.clamp(speed / 8, 0, 1) else 0
	enemy.phase += math.min(dt, 0.1) * (4 + math.min(speed, 16) * 0.9)
	local scale = root.Size.X / 3.1
	local boar = enemy.model:GetAttribute("EnemyKind") == "boar"
	local anticipation = progress * progress
	local rightArm, leftArm, lean, twist = 0, 0, 0, 0
	if state == "MeleeWindup" then
		rightArm, leftArm, lean, twist = anticipation * 1.2, -anticipation * 0.2, anticipation * 0.12, -anticipation * 0.3
	elseif state == "MeleeRecover" then
		rightArm, leftArm, lean, twist = -1.15 * (1 - progress), 0.2 * (1 - progress), -0.18 * (1 - progress), 0.3 * (1 - progress)
	elseif state == "SkillWindup" then
		rightArm, leftArm, lean = anticipation * 2.55, anticipation * 2.55, anticipation * 0.14
	end
	local lunge, headShift, neckPitch, foreleg = 0, 0, 0, 0
	if boar then
		-- A tusked animal braces, draws its head back, then snaps forward;
		-- it has no humanoid arm to inherit the guardian's punch animation.
		twist, lean = 0, 0
		if state == "MeleeWindup" or state == "SkillWindup" then
			lunge, headShift, neckPitch, foreleg = -0.2 * anticipation, -0.25 * anticipation, -0.12 * anticipation, 0.18 * anticipation
			lean = -0.08 * anticipation
		elseif state == "MeleeRecover" then
			local impact = 1 - progress
			lunge, headShift, neckPitch, foreleg = 0.45 * impact, 0.4 * impact, 0.2 * impact, -0.4 * impact
			lean = 0.08 * impact
		end
	end
	local dead = if state == "Dead" then progress else 0
	local shrink = math.max(0.04, 1 - dead * 0.96)
	local bob = (math.sin(enemy.phase * 2) * 0.07 * gait + math.sin(now * 2.2) * 0.025) * scale
	local body = frame * CFrame.new(0, bob - dead * 1.1 * scale, lunge * scale)
		* CFrame.Angles(lean, twist, dead * 0.65)
	for _, piece in enemy.pieces do
		local name, offset = piece.source.Name, piece.offset
		local side = if offset.X < 0 then -1 else 1
		if name == "RootLeg" or name == "RootFoot" or name == "Leg" or name == "Foot" then
			local phase = if side < 0 then 0 else math.pi
			if offset.Z < -0.4 then phase += math.pi end
			local stride = math.sin(enemy.phase + phase) * 0.35 * gait
			if boar and offset.Z > 0 then stride += foreleg end
			local hip = Vector3.new(offset.X, -1.1 * scale, offset.Z)
			offset = CFrame.new(hip) * CFrame.Angles(stride, 0, 0) * CFrame.new(-hip) * offset
		elseif name == "BranchArm" or name == "KnottedFist" then
			local swing = if side > 0 then rightArm else leftArm
			swing -= math.sin(enemy.phase + (if side > 0 then 0 else math.pi)) * 0.2 * gait
			local shoulder = Vector3.new(side * 1.7 * scale, 0.85 * scale, 0)
			offset = CFrame.new(shoulder) * CFrame.Angles(swing, 0, 0) * CFrame.new(-shoulder) * offset
		elseif boar and (name == "Head" or name == "Snout" or name == "Tusk" or name == "Eye" or name == "Ear") then
			local neck = Vector3.new(0, 0.15 * scale, 1.25 * scale)
			offset = CFrame.new(0, 0, headShift * scale) * CFrame.new(neck)
				* CFrame.Angles(neckPitch, 0, 0) * CFrame.new(-neck) * offset
		elseif name == "Head" or name == "Eye" or name == "Brow" or string.find(name, "Crown") or name == "AncientCrest" then
			local neck = Vector3.new(0, 1.3 * scale, 0)
			offset = CFrame.new(neck) * CFrame.Angles(-lean * 0.7, -twist * 0.25, 0) * CFrame.new(-neck) * offset
		end
		piece.part.Size = piece.size * shrink
		piece.part.Transparency = piece.transparency + (1 - piece.transparency) * dead
		piece.part.CFrame = body * (CFrame.new(offset.Position * shrink) * offset.Rotation)
	end
end

function EnemyView.start(): () -> ()
	local container = Instance.new("Folder")
	container.Name = "LocalGuardianVisuals"
	container:SetAttribute("CosmeticOnly", true)
	container.Parent = workspace
	local enemies: { [Model]: Enemy } = {}
	local folders: { [Instance]: FolderWatch } = {}
	local stopped = false
	local function removeEnemy(item: Instance)
		if not item:IsA("Model") then return end
		local enemy = enemies[item]
		if not enemy then return end
		disconnect(enemy.connections)
		for source in enemy.pieces do removePiece(enemy, source) end
		enemy.visual:Destroy()
		enemies[item] = nil
	end
	local function addEnemy(item: Instance)
		if stopped or not item:IsA("Model") or enemies[item] then return end
		local visual = Instance.new("Model")
		visual.Name = item.Name
		visual:SetAttribute("CosmeticOnly", true)
		visual.Parent = container
		local enemy: Enemy = { model = item, visual = visual, pieces = {}, connections = {}, root = nil,
			frame = nil, dirty = true, phase = 0, state = "", changedAt = 0 }
		enemies[item] = enemy
		table.insert(enemy.connections, item.DescendantAdded:Connect(function() enemy.dirty = true end))
		table.insert(enemy.connections, item.DescendantRemoving:Connect(function(descendant)
			if descendant:IsA("BasePart") then removePiece(enemy, descendant) end
		end))
	end
	local function detach(folder: Instance, watch: FolderWatch)
		for _, child in folder:GetChildren() do removeEnemy(child) end
		-- A folder may have been removed along with its children before this event.
		for model in enemies do if model.Parent == folder then removeEnemy(model) end end
		for index = #watch.connections, 2, -1 do watch.connections[index]:Disconnect(); table.remove(watch.connections, index) end
		watch.active = false
	end
	local function refreshFolder(folder: Instance, watch: FolderWatch)
		local active = not stopped and folder.Parent == workspace and folder.Name == "WildbondGuardians"
		if watch.active and not active then detach(folder, watch) end
		if active and not watch.active then
			watch.active = true
			table.insert(watch.connections, folder.ChildAdded:Connect(addEnemy))
			table.insert(watch.connections, folder.ChildRemoved:Connect(removeEnemy))
			for _, child in folder:GetChildren() do addEnemy(child) end
		end
	end
	local function watchFolder(folder: Instance)
		if stopped or folder == container or not folder:IsA("Folder") or folders[folder] then return end
		local watch: FolderWatch = { active = false, connections = {} }
		folders[folder] = watch
		table.insert(watch.connections, folder:GetPropertyChangedSignal("Name"):Connect(function() refreshFolder(folder, watch) end))
		refreshFolder(folder, watch)
	end
	local function removeFolder(folder: Instance)
		local watch = folders[folder]
		if not watch then return end
		if watch.active then detach(folder, watch) end
		disconnect(watch.connections)
		folders[folder] = nil
	end
	for _, folder in workspace:GetChildren() do watchFolder(folder) end
	local added = workspace.ChildAdded:Connect(watchFolder)
	local removed = workspace.ChildRemoved:Connect(removeFolder)
	local render = RunService.RenderStepped:Connect(function(dt: number)
		local now = workspace:GetServerTimeNow()
		for model, enemy in enemies do
			if model.Parent then animate(enemy, dt, now, container) else removeEnemy(model) end
		end
	end)
	return function()
		if stopped then return end
		stopped = true
		render:Disconnect(); added:Disconnect(); removed:Disconnect()
		for folder in folders do removeFolder(folder) end
		for model in enemies do removeEnemy(model) end
		container:Destroy()
	end
end

return EnemyView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[--!nonstrict
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")

local Hud = {}
local ink = Color3.fromRGB(30, 52, 55)
local cream = Color3.fromRGB(250, 245, 226)
local mint = Color3.fromRGB(119, 214, 173)
local amber = Color3.fromRGB(244, 186, 91)
local targetInfo = {
	{ id = "moss", title = "Bramble Sprout", position = Vector3.new(-45, 7, -25) },
	{ id = "river", title = "Reed Guardian", position = Vector3.new(0, 7, -65) },
	{ id = "ruins", title = "The Hollow Crown", position = Vector3.new(65, 7, -80) },
}

local function make(class, properties, parent)
	local item = Instance.new(class)
	for key, value in properties do
		item[key] = value
	end
	item.Parent = parent
	return item
end

local function round(item, pixels)
	make("UICorner", { CornerRadius = UDim.new(0, pixels or 12) }, item)
end

local function label(parent, text, position, size, fontSize, color)
	return make("TextLabel", {
		BackgroundTransparency = 1, Text = text, Position = position, Size = size,
		TextColor3 = color or cream, TextSize = fontSize or 16,
		Font = Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
	}, parent)
end

local function button(parent, text, position, size, callback)
	local item = make("TextButton", {
		Text = text, Position = position, Size = size,
		BackgroundColor3 = mint, TextColor3 = ink, Font = Enum.Font.GothamBold,
		TextSize = 15, AutoButtonColor = true, BorderSizePixel = 0,
	}, parent)
	round(item, 10)
	item.Activated:Connect(callback)
	return item
end

function Hud.start(command, catalog, rules, dodgeRules)
	rules = rules or { meleeCooldown = 0.6, petCooldown = 3.2 }
	dodgeRules = dodgeRules or { cooldown = 4 }
	local player = Players.LocalPlayer
	local destroyed = false
	local currentState, stateClock, refreshTiming, refreshCooldowns, refreshPet
	local screen = make("ScreenGui", { Name = "WildbondHUD", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, player:WaitForChild("PlayerGui"))
	local gui = make("Frame", { Name = "Canvas", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, screen)
	local scale = make("UIScale", { Scale = 1 }, gui)
	local attackButton, bondButton, dodgeButton, hotbar, companionToggle
	local function resize()
		local camera = workspace.CurrentCamera
		if camera then
			scale.Scale = math.clamp(math.min(camera.ViewportSize.X / 850, camera.ViewportSize.Y / 480), 0.5, 1)
			gui.Size = UDim2.fromScale(1 / scale.Scale, 1 / scale.Scale)
			if attackButton then
				local hotbarBottom = if UserInputService.TouchEnabled then 145 else 76 * scale.Scale
				-- Keep at least the former 194-pixel native-jump gap, and put
				-- the action row above the hotbar at every scale and aspect ratio.
				local hintGap = if UserInputService.TouchEnabled then 12 else 36 * scale.Scale
				local rowTop = hotbarBottom + 132 * scale.Scale + hintGap
				if UserInputService.TouchEnabled then rowTop = math.max(194, rowTop) end
				attackButton.Position = UDim2.new(1, -134, 1, -math.round(rowTop / scale.Scale))
				bondButton.Position = UDim2.new(1, -260, 1, attackButton.Position.Y.Offset)
				dodgeButton.Position = UDim2.new(1, -134, 1, -math.round((rowTop + 58 * scale.Scale + 20) / scale.Scale))
				hotbar.Position = UDim2.new(0.5, 0, 1, -math.round(hotbarBottom / scale.Scale))
				if UserInputService.TouchEnabled then companionToggle.Position = UDim2.new(1, -340, 0, 18) end
			end
		end
	end
	resize()
	-- Polling covers camera replacement after respawn without retaining camera connections.
	local resizeClock = 0
	local resizeConnection = RunService.RenderStepped:Connect(function(dt)
		if refreshCooldowns then refreshCooldowns() end
		if refreshPet then refreshPet() end
		resizeClock += dt
		if resizeClock >= 1 then
			resizeClock = 0
			resize()
			if refreshTiming then refreshTiming() end
		end
	end)

	local mission = make("Frame", {
		Position = UDim2.fromOffset(18, 18), Size = UDim2.fromOffset(320, 272),
		BackgroundColor3 = ink, BackgroundTransparency = 0.08, BorderSizePixel = 0,
	}, gui)
	round(mission, 16)
	label(mission, "WILDBOND  v0.4.0", UDim2.fromOffset(18, 12), UDim2.fromOffset(280, 26), 23, mint)
	label(mission, "GREYWATER REACH  /  PVE ALPHA", UDim2.fromOffset(18, 42), UDim2.fromOffset(280, 18), 10)
	local objective = label(mission, "Find the hunt board in the village.", UDim2.fromOffset(18, 70), UDim2.fromOffset(284, 42), 16)
	local rows = {}
	for index, target in targetInfo do
		rows[target.id] = label(mission, "○  " .. target.title, UDim2.fromOffset(18, 111 + index * 25), UDim2.fromOffset(284, 23), 14)
	end
	local timingLabel = label(mission, "Hunt timer starts at the board.", UDim2.fromOffset(18, 217), UDim2.fromOffset(284, 22), 11, amber)
	label(mission, "Session progress · saving comes next", UDim2.fromOffset(18, 246), UDim2.fromOffset(284, 16), 10, Color3.fromRGB(184, 201, 198))
	local function duration(seconds)
		local whole = math.max(0, math.floor(seconds))
		return string.format("%d:%02d", math.floor(whole / 60), whole % 60)
	end
	local function falls(count)
		return tostring(count) .. (if count == 1 then " fall" else " falls")
	end
	refreshTiming = function()
		if not currentState or not currentState.timing then return end
		local timing = currentState.timing
		if currentState.active then
			timingLabel.Text = duration((timing.elapsed or 0) + os.clock() - stateClock) .. " elapsed · " .. falls(timing.deaths or 0)
		elseif timing.lastDuration then
			timingLabel.Text = "Last " .. duration(timing.lastDuration) .. " · best " .. duration(timing.bestDuration or timing.lastDuration) .. " · falls " .. tostring(timing.lastDeaths or 0)
		end
	end

	local purse = make("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -18, 0, 18), Size = UDim2.fromOffset(216, 98), BackgroundColor3 = ink, BorderSizePixel = 0 }, gui)
	round(purse, 14)
	local shells = label(purse, "0 shells", UDim2.fromOffset(14, 9), UDim2.fromOffset(188, 27), 22, amber)
	local hunts = label(purse, "0 hunts completed", UDim2.fromOffset(14, 41), UDim2.fromOffset(188, 18), 11)
	local progression = label(purse, "LV 1 · 0 coins · 0 XP", UDim2.fromOffset(14, 67), UDim2.fromOffset(188, 20), 11, mint)
	local petStatus = make("Frame", { Name = "CompanionStatus", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -18, 0, 124), Size = UDim2.fromOffset(216, 72), BackgroundColor3 = ink, BorderSizePixel = 0 }, gui)
	round(petStatus, 12)
	local petHealth = label(petStatus, "Companion arriving…", UDim2.fromOffset(12, 7), UDim2.fromOffset(192, 18), 12, mint)
	petHealth.Name = "PetHealth"
	local petStats = label(petStatus, "", UDim2.fromOffset(12, 27), UDim2.fromOffset(192, 16), 10)
	petStats.Name = "PetStats"
	local petMode = label(petStatus, "Auto attack · auto skill", UDim2.fromOffset(12, 47), UDim2.fromOffset(192, 16), 10, amber)
	petMode.Name = "PetMode"
	refreshPet = function()
		local hp, maximum = player:GetAttribute("PetHealth"), player:GetAttribute("PetMaxHealth")
		local state = player:GetAttribute("PetState")
		if typeof(hp) ~= "number" or typeof(maximum) ~= "number" then return end
		petHealth.Text = string.format("Companion %d / %d HP", math.max(0, math.floor(hp)), math.max(1, math.floor(maximum)))
		petStats.Text = string.format("ATK %d · skill %d · DEF %d", player:GetAttribute("PetAttackDamage") or 0, player:GetAttribute("PetSkillDamage") or 0, player:GetAttribute("PetDefense") or 0)
		if state == "Dead" then
			local respawnAt = player:GetAttribute("PetRespawnAt")
			local remaining = typeof(respawnAt) == "number" and respawnAt > 0 and math.max(0, respawnAt - workspace:GetServerTimeNow()) or nil
			petMode.Text = if remaining then string.format("Reviving in %.1fs", remaining) else "Leave combat to revive companion"
			petHealth.TextColor3 = amber
		else
			petHealth.TextColor3 = mint
			local readyAt = player:GetAttribute("PetSkillReadyAt") or 0
			local remaining = math.max(0, readyAt - workspace:GetServerTimeNow())
			petMode.Text = if remaining > 0 then string.format("Auto skill %.1fs · %s", remaining, if player:GetAttribute("InCombat") then "in combat" else "following") else "Auto attack · auto skill ready"
		end
	end

	local health = make("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -23), Size = UDim2.fromOffset(220, 14), BackgroundColor3 = ink, BorderSizePixel = 0 }, gui)
	round(health, 7)
	local healthFill = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = mint, BorderSizePixel = 0 }, health)
	round(healthFill, 7)
	local healthText = label(gui, "100 / 100", UDim2.new(0.5, -50, 1, -60), UDim2.fromOffset(100, 22), 13)
	healthText.TextXAlignment = Enum.TextXAlignment.Center
	local healthConnection
	local function watchCharacter(character)
		if healthConnection then
			healthConnection:Disconnect()
		end
		local humanoid = character:WaitForChild("Humanoid", 10)
		if destroyed or not humanoid then return end
		local function changed()
			local fraction = math.clamp(humanoid.Health / math.max(1, humanoid.MaxHealth), 0, 1)
			TweenService:Create(healthFill, TweenInfo.new(0.15), { Size = UDim2.fromScale(fraction, 1) }):Play()
			healthText.Text = string.format("%d / %d", humanoid.Health, humanoid.MaxHealth)
		end
		healthConnection = humanoid.HealthChanged:Connect(changed)
		changed()
	end
	local characterConnection = player.CharacterAdded:Connect(watchCharacter)
	if player.Character then task.spawn(watchCharacter, player.Character) end

	local toast = label(gui, "", UDim2.new(0.5, -230, 0, 106), UDim2.fromOffset(460, 48), 16)
	toast.TextXAlignment = Enum.TextXAlignment.Center
	toast.BackgroundColor3 = ink
	toast.BackgroundTransparency = 0.08
	toast.Visible = false
	round(toast, 12)
	local toastVersion = 0
	local function notify(message, success)
		if not message then return end
		toastVersion += 1
		local version = toastVersion
		toast.Text = message
		toast.TextColor3 = if success == false then amber else cream
		toast.Visible = true
		task.delay(3.5, function()
			if version == toastVersion then toast.Visible = false end
		end)
	end

	local petPanel = make("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -18, 0, 252), Size = UDim2.fromOffset(320, 213), BackgroundColor3 = ink, BorderSizePixel = 0, Visible = false }, gui)
	round(petPanel, 14)
	label(petPanel, "YOUR COMPANIONS", UDim2.fromOffset(16, 10), UDim2.fromOffset(240, 22), 15, mint)
	label(petPanel, "Hunts earn shells · each pet has its own stats.", UDim2.fromOffset(16, 36), UDim2.fromOffset(288, 20), 11)
	local petButtons = {}
	for index, pet in catalog do
		label(petPanel, pet.name, UDim2.fromOffset(16, 66 + (index - 1) * 45), UDim2.fromOffset(160, 34), 14)
		petButtons[pet.id] = button(petPanel, tostring(pet.cost) .. " shells", UDim2.fromOffset(182, 65 + (index - 1) * 45), UDim2.fromOffset(122, 34), function()
			if not currentState then return end
			local action = if currentState.owned[pet.id] then "equip" else "unlock"
			command:FireServer(action, pet.id)
		end)
	end
	companionToggle = button(gui, "Companions", UDim2.new(1, -174, 0, 204), UDim2.fromOffset(156, 42), function()
		petPanel.Visible = not petPanel.Visible
	end)

	local lastAttackRequest, attackReadyAt = -math.huge, 0
	local lastBondRequest, bondReadyAt = -math.huge, 0
	local lastDodgeRequest, dodgeReadyAt = -math.huge, 0
	local function focused()
		return destroyed or UserInputService:GetFocusedTextBox() ~= nil
	end
	local function attack()
		if focused() then return end
		local now = os.clock()
		if now < attackReadyAt or now - lastAttackRequest < rules.meleeCooldown then return end
		lastAttackRequest = now
		command:FireServer("attack")
	end
	local function bond()
		if focused() then return end
		local now = os.clock()
		if player:GetAttribute("PetState") == "Dead" or now < bondReadyAt or workspace:GetServerTimeNow() < (player:GetAttribute("PetSkillReadyAt") or 0) or now - lastBondRequest < 0.2 then return end
		lastBondRequest = now
		command:FireServer("bond")
	end
	local function dodge()
		if focused() then return end
		local now = os.clock()
		if now < dodgeReadyAt or now - lastDodgeRequest < 0.2 then return end
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then return end
		local direction = humanoid.MoveDirection * Vector3.new(1, 0, 1)
		if direction.Magnitude < 0.01 then direction = root.CFrame.LookVector * Vector3.new(1, 0, 1) end
		if direction.Magnitude < 0.01 then return end
		lastDodgeRequest = now
		command:FireServer("dodge", direction.Unit)
	end
	attackButton = button(gui, "STRIKE", UDim2.new(1, -134, 1, if UserInputService.TouchEnabled then -194 else -96), UDim2.fromOffset(116, 66), attack)
	bondButton = button(gui, "PET SKILL", UDim2.new(1, -260, 1, if UserInputService.TouchEnabled then -194 else -96), UDim2.fromOffset(116, 66), bond)
	dodgeButton = button(gui, "DODGE", UDim2.new(1, -134, 1, if UserInputService.TouchEnabled then -276 else -174), UDim2.fromOffset(116, 58), dodge)
	-- Slot 1 is a temporary companion command while class skills are being built.
	-- Empty slots deliberately have no click or key actions.
	hotbar = make("Frame", { Name = "SkillHotbar", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -76), Size = UDim2.fromOffset(566, 66), BackgroundTransparency = 1 }, gui)
	local slots = {}
	for index = 1, 8 do
		local slot = make(if index == 1 then "TextButton" else "TextLabel", {
			Name = "SkillSlot" .. tostring(index), Position = UDim2.fromOffset((index - 1) * 72, 0), Size = UDim2.fromOffset(62, 62),
			Text = "", BackgroundColor3 = if index == 1 then ink else Color3.fromRGB(43, 58, 61),
			BackgroundTransparency = if index == 1 then 0.08 else 0.25, BorderSizePixel = 0,
		}, hotbar)
		round(slot, 10)
		label(slot, tostring(index), UDim2.fromOffset(6, 3), UDim2.fromOffset(18, 16), 11, if index == 1 then mint else Color3.fromRGB(160, 170, 171))
		slots[index] = label(slot, if index == 1 then "Pet skill" else "Unlearned", UDim2.fromOffset(3, 22), UDim2.fromOffset(56, 30), if index == 1 then 13 else 9, if index == 1 then cream else Color3.fromRGB(160, 170, 171))
		if index == 1 then slot.Activated:Connect(bond) end
	end
	refreshCooldowns = function()
		local now = os.clock()
		for _, entry in { { attackButton, attackReadyAt, "STRIKE" }, { bondButton, bondReadyAt, "PET SKILL" }, { dodgeButton, dodgeReadyAt, "DODGE" } } do
			local remaining = math.max(0, entry[2] - now)
			if entry[1] == bondButton then remaining = math.max(remaining, (player:GetAttribute("PetSkillReadyAt") or 0) - workspace:GetServerTimeNow()) end
			entry[1].Text = if remaining > 0 then string.format("%s %.1f", entry[3], remaining) else entry[3]
			entry[1].BackgroundColor3 = if remaining > 0 then amber else mint
		end
		local remaining = math.max(0, bondReadyAt - now, (player:GetAttribute("PetSkillReadyAt") or 0) - workspace:GetServerTimeNow())
		slots[1].Text = if remaining > 0 then string.format("Pet skill\n%.1f", remaining) else "Pet skill"
	end
	resize()
	local controlsHint = label(gui, "Click / R2 strike · 1 / L2 pet skill · Shift / B dodge", UDim2.new(0.5, -245, 1, -166), UDim2.fromOffset(490, 20), 10)
	controlsHint.TextXAlignment = Enum.TextXAlignment.Center
	controlsHint.Visible = not UserInputService.TouchEnabled
	local inputConnection = UserInputService.InputBegan:Connect(function(input, processed)
		if processed or focused() then return end
		if input.KeyCode == Enum.KeyCode.ButtonR2 or input.UserInputType == Enum.UserInputType.MouseButton1 then
			attack()
		elseif input.KeyCode == Enum.KeyCode.One or input.KeyCode == Enum.KeyCode.ButtonL2 then
			bond()
		elseif input.KeyCode == Enum.KeyCode.ButtonB then
			dodge()
		elseif input.KeyCode == Enum.KeyCode.C or input.KeyCode == Enum.KeyCode.ButtonY then
			petPanel.Visible = not petPanel.Visible
		end
	end)
	local dodgeAction = "WildbondShiftDodge"
	ContextActionService:BindActionAtPriority(dodgeAction, function(_, state)
		if focused() then return Enum.ContextActionResult.Pass end
		if state == Enum.UserInputState.Begin then dodge() end
		-- Consume Shift start/end so it cannot toggle Roblox mouse lock.
		-- Space remains completely unbound and keeps ordinary jumping.
		return Enum.ContextActionResult.Sink
	end, false, Enum.ContextActionPriority.High.Value + 10, Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift)

	local waypoint = make("Part", { Name = "LocalHuntWaypoint", Size = Vector3.new(1.2, 8, 1.2), Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false, Material = Enum.Material.Neon, Color = mint, Transparency = 0.65 }, workspace)
	local waypointBillboard = make("BillboardGui", { Size = UDim2.fromOffset(210, 50), StudsOffset = Vector3.new(0, 5, 0), AlwaysOnTop = true, MaxDistance = 400 }, waypoint)
	local waypointText = label(waypointBillboard, "HUNT BOARD", UDim2.fromScale(0, 0), UDim2.fromScale(1, 1), 16, cream)
	waypointText.TextXAlignment = Enum.TextXAlignment.Center
	waypointText.TextStrokeTransparency = 0.2

	local welcome = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(460, 312), BackgroundColor3 = ink, BorderSizePixel = 0 }, gui)
	welcome.ZIndex = 10
	round(welcome, 18)
	label(welcome, "A woodland trail. A wild bond.", UDim2.fromOffset(26, 23), UDim2.fromOffset(408, 54), 26, mint)
	label(welcome, "Take a hunt at the village board. Click / R2 strikes; Shift / B dodges; Space jumps.\n\nPets fight and use skills on their own. 1 / L2 requests a pet skill. Collect three crystals, then return for 60 shells. Slots 2–8 await class skills.", UDim2.fromOffset(26, 87), UDim2.fromOffset(408, 127), 15)
	label(welcome, "Early prototype · progress resets when you leave.\nCompanions revive after 10s out of combat. No purchases enabled.", UDim2.fromOffset(26, 219), UDim2.fromOffset(408, 37), 11, amber)
	button(welcome, "Explore Greywater Reach", UDim2.fromOffset(26, 266), UDim2.fromOffset(408, 34), function()
		welcome:Destroy()
	end)
	for _, child in welcome:GetDescendants() do
		if child:IsA("GuiObject") then child.ZIndex = 11 end
	end

	local api = {}
	function api:meleeAccepted(cooldown)
		if destroyed then return end
		attackReadyAt = os.clock() + (cooldown or rules.meleeCooldown)
		refreshCooldowns()
	end
	function api:bondAccepted(cooldown)
		if destroyed then return end
		bondReadyAt = os.clock() + (cooldown or rules.petCooldown)
		refreshCooldowns()
	end
	function api:dodgeAccepted(cooldown)
		if destroyed then return end
		dodgeReadyAt = os.clock() + (cooldown or dodgeRules.cooldown)
		refreshCooldowns()
	end
	function api:render(state, message, success)
		if destroyed then return end
		currentState = state
		stateClock = os.clock()
		refreshTiming()
		shells.Text = tostring(state.shells) .. " shells"
		hunts.Text = tostring(state.huntsCompleted) .. " hunts completed"
		local progress = state.progression
		if progress then
			progression.Text = string.format("LV %d · %d coins · %d/%d XP", progress.level, progress.coins, progress.xp, progress.nextLevelXp or 0)
		end
		local collected = 0
		local nextTarget
		for _, target in targetInfo do
			local done = state.collected[target.id]
			if done then collected += 1 elseif not nextTarget then nextTarget = target end
			rows[target.id].Text = (if done then "✓  " elseif state.defeated[target.id] then "◇  " else "○  ") .. target.title .. (if state.defeated[target.id] and not done then " · collect" else "")
			rows[target.id].TextColor3 = if done then mint else cream
		end
		if not state.active then
			objective.Text = "Take a hunt from the village board."
			waypoint.Position = Vector3.new(0, 10, 15)
			waypointText.Text = "HUNT BOARD"
		elseif collected == 3 then
			objective.Text = "Return to camp · 60 shells waiting."
			waypoint.Position = Vector3.new(12, 10, 15)
			waypointText.Text = "RETURN TO CAMP"
		else
			objective.Text = tostring(collected) .. "/3 crystals · dodge red circles."
			local destination = nextTarget.position
			if not state.defeated[nextTarget.id] then
				for _, foe in rules.foes or {} do
					if foe.id == nextTarget.id then destination = Vector3.new(foe.position.x, foe.position.y, foe.position.z) end
				end
			end
			waypoint.Position = destination + Vector3.new(0, 3, 0)
			waypointText.Text = if state.defeated[nextTarget.id] then "COLLECT CRYSTAL" else nextTarget.title
		end
		for _, pet in catalog do
			petButtons[pet.id].Text = if state.equipped == pet.id then "Equipped" elseif state.owned[pet.id] then "Equip" else tostring(pet.cost) .. " shells"
			petButtons[pet.id].BackgroundColor3 = if state.equipped == pet.id then amber else mint
		end
		notify(message, success)
	end
	function api:destroy()
		if destroyed then return end
		destroyed = true
		toastVersion += 1
		resizeConnection:Disconnect()
		inputConnection:Disconnect()
		ContextActionService:UnbindAction(dodgeAction)
		characterConnection:Disconnect()
		if healthConnection then healthConnection:Disconnect() end
		waypoint:Destroy()
		screen:Destroy()
	end
	return api
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">PlayerCombatView</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Native procedural animation supports legacy Motor6D and upgraded R15
-- AnimationConstraint joints. Restore our layer before Animator evaluates, then
-- apply it at PreSimulation after Animator; no attachment/C0 mutation or asset
-- upload is needed. Server effects authorize strikes and root movement.
-- https://create.roblox.com/docs/reference/engine/classes/AnimationConstraint
local RunService = game:GetService("RunService")
local View = {}
local punchDuration = 0.42
local function finiteVector(value)
	return typeof(value) == "Vector3" and value.X == value.X and value.Y == value.Y and value.Z == value.Z
		and math.abs(value.X) < math.huge and math.abs(value.Y) < math.huge and math.abs(value.Z) < math.huge
end
local function sameFrame(a, b)
	return (a.Position - b.Position).Magnitude < 0.0001
		and (a.LookVector - b.LookVector).Magnitude < 0.0001 and (a.UpVector - b.UpVector).Magnitude < 0.0001
end

function View.start(player, dodgeRules)
	local dodgeDuration = (dodgeRules and dodgeRules.duration) or 0.3
	local stopped, character = false, player.Character
	local arms, legs, torso, rootJoint, states = {}, {}, nil, nil, {}
	local punch, dash, impact, nextLeft, scanAt = nil, nil, nil, false, 0
	local effects = Instance.new("Folder")
	effects.Name = "LocalPlayerCombatEffects"
	effects:SetAttribute("CosmeticOnly", true)
	effects.Parent = workspace
	local function piece(name, size)
		local part = Instance.new("Part")
		part.Name, part.Size = name, size
		part.Anchored, part.CastShadow = true, false
		part.CanCollide, part.CanTouch, part.CanQuery = false, false, false
		part.Material, part.Color = Enum.Material.Neon, Color3.fromRGB(232, 241, 207)
		part.Transparency, part.Parent = 1, effects
		return part
	end
	local trail, sparks, wake = {}, {}, {}
	for index = 1, 2 do wake[index] = piece("DodgeWake" .. index, Vector3.new(0.06, 0.06, 3)) end
	for index = 1, 4 do
		trail[index] = piece("FistTrail" .. index, Vector3.new(0.08, 0.08, 0.3))
		sparks[index] = piece("HitSpark" .. index, Vector3.new(0.1, 0.1, 0.45))
	end
	local impactAnchor = piece("ImpactOrigin", Vector3.new(0.08, 0.08, 0.08))
	local popup = Instance.new("BillboardGui")
	popup.Name, popup.Size, popup.AlwaysOnTop = "HitDamage", UDim2.fromOffset(100, 36), false
	popup.MaxDistance, popup.Enabled, popup.Parent = 70, false, impactAnchor
	local damageText = Instance.new("TextLabel")
	damageText.Size, damageText.BackgroundTransparency = UDim2.fromScale(1, 1), 1
	damageText.Font, damageText.TextSize = Enum.Font.GothamBold, 18
	damageText.TextColor3, damageText.TextStrokeTransparency = Color3.fromRGB(243, 229, 178), 0.5
	damageText.Text, damageText.Parent = "", popup
	local function hideTrail() for _, part in trail do part.Transparency = 1 end end
	local function hideWake() for _, part in wake do part.Transparency = 1 end end
	local function hideImpact()
		for _, part in sparks do part.Transparency = 1 end
		popup.Enabled = false
	end
	local function restorePose()
		for joint, state in states do
			if joint.Parent and sameFrame(joint.Transform, state.applied) then joint.Transform = state.base end
		end
		table.clear(states)
	end
	local function jointFrames(joint)
		if joint:IsA("AnimationConstraint") then
			local a, b = joint.Attachment0, joint.Attachment1
			if a and b and a.Parent and b.Parent and a.Parent:IsA("BasePart") and b.Parent:IsA("BasePart") then
				return a.Parent, b.Parent, a.CFrame, b.CFrame
			end
		elseif joint:IsA("Motor6D") and joint.Part0 and joint.Part1 then
			return joint.Part0, joint.Part1, joint.C0, joint.C1
		end
		return nil
	end
	local function discoverJoints()
		arms, legs, torso, rootJoint = { right = {}, left = {} }, { right = {}, left = {} }, nil, nil
		if not character then return end
		local count, upgraded = 0, 0
		for _, item in character:GetDescendants() do
			if item:IsA("Motor6D") or item:IsA("AnimationConstraint") then
				local _, child = jointFrames(item)
				if not child then continue end
				count += 1
				if item:IsA("AnimationConstraint") then upgraded += 1 end
				-- Match connected limb names as well as joint names: upgraded
				-- constraints and custom rig exports can rename the joint itself.
				if child.Name == "LowerTorso" or child.Name == "Torso" or item.Name == "Root" or item.Name == "RootJoint" then rootJoint = item end
				if child.Name == "UpperTorso" or item.Name == "Waist" then torso = item end
				for _, side in { "right", "left" } do
					local prefix = if side == "right" then "Right" else "Left"
					if child.Name == prefix .. "UpperArm" or child.Name == prefix .. " Arm" or item.Name == prefix .. "Shoulder" or item.Name == prefix .. " Shoulder" then arms[side].shoulder = item end
					if child.Name == prefix .. "LowerArm" or item.Name == prefix .. "Elbow" then arms[side].elbow = item end
					if child.Name == prefix .. "Hand" or item.Name == prefix .. "Wrist" then arms[side].wrist = item end
					if child.Name == prefix .. "UpperLeg" or child.Name == prefix .. " Leg" or item.Name == prefix .. "Hip" or item.Name == prefix .. " Hip" then legs[side].hip = item end
					if child.Name == prefix .. "LowerLeg" or item.Name == prefix .. "Knee" then legs[side].knee = item end
					if child.Name == prefix .. "Foot" or item.Name == prefix .. "Ankle" then legs[side].ankle = item end
				end
			end
		end
		torso = torso or rootJoint
		character:SetAttribute("WildbondCombatJointCount", count)
		character:SetAttribute("WildbondCombatRig", if upgraded > 0 then "AnimationConstraint" elseif count > 0 then "Motor6D" else "Waiting for rig")
		character:SetAttribute("WildbondCombatReady", arms.right.shoulder ~= nil and arms.left.shoulder ~= nil and rootJoint ~= nil and legs.right.hip ~= nil and legs.left.hip ~= nil)
		scanAt = os.clock() + 0.5
	end
	local function setCharacter(nextCharacter)
		restorePose(); hideTrail(); hideImpact(); hideWake()
		punch, dash, impact, character, nextLeft = nil, nil, nil, nextCharacter, false
		discoverJoints()
	end
	discoverJoints()
	local added = player.CharacterAdded:Connect(setCharacter)
	local removed = player.CharacterRemoving:Connect(function(old) if character == old then setCharacter(nil) end end)
	local function rootPart()
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then return nil end
		return root
	end
	local function compose(joint, rotation)
		if not joint or not joint.Parent then return end
		local _, _, c0 = jointFrames(joint)
		if not c0 then return end
		local base = joint.Transform
		local previous = states[joint]
		if previous and sameFrame(base, previous.applied) then base = previous.base end
		-- Convert Part0-space rotations into the attachment's local axes.
		-- R6 shoulder/hip attachments have different axes from R15.
		joint.Transform = c0.Rotation:Inverse() * rotation * c0.Rotation * base
		states[joint] = { base = base, applied = joint.Transform }
	end
	local function fistPosition(arm)
		local joint = arm.shoulder
		if not joint then return nil end
		local parent, part, c0, c1 = jointFrames(joint)
		if not parent then return nil end
		local frame = parent.CFrame * c0 * joint.Transform * c1:Inverse()
		for _, nextJoint in { arm.elbow, arm.wrist } do
			if nextJoint then
				local nextParent, nextPart, nextC0, nextC1 = jointFrames(nextJoint)
				if nextParent == part then
					frame = frame * nextC0 * nextJoint.Transform * nextC1:Inverse()
					part = nextPart
				end
			end
		end
		return frame:PointToWorldSpace(Vector3.new(0, -part.Size.Y * 0.45, 0))
	end
	local function update()
		if stopped then return end
		local root, now = rootPart(), os.clock()
		if not root then
			restorePose(); hideTrail(); hideImpact(); hideWake()
			punch, dash, impact = nil, nil, nil
			return
		end
		local function incomplete(limb, primary, second, third, r15Part)
			local joint = limb and limb[primary]
			if not joint or not joint.Parent then return true end
			local _, child = jointFrames(joint)
			return child and string.find(child.Name, r15Part, 1, true) ~= nil
				and (not limb[second] or not limb[second].Parent or not limb[third] or not limb[third].Parent)
		end
		local missing = punch and incomplete(arms[punch.side], "shoulder", "elbow", "wrist", "UpperArm")
		if dash then
			missing = missing or not rootJoint or not rootJoint.Parent
			for _, side in { "right", "left" } do
				missing = missing or incomplete(arms[side], "shoulder", "elbow", "wrist", "UpperArm")
					or incomplete(legs[side], "hip", "knee", "ankle", "UpperLeg")
			end
		end
		if now >= scanAt or missing then discoverJoints() end
		if punch and now - punch.started >= punchDuration then punch = nil; hideTrail() end
		if dash and now - dash.started >= dodgeDuration then dash = nil; hideWake() end
		restorePose()
		local torsoPose = CFrame.identity
		if punch then
			local age, arm = now - punch.started, arms[punch.side]
			local isR15 = arm.elbow ~= nil
			local draw = if isR15 then 25 else -22
			local shoulderAngle, elbowAngle, envelope
			if age < 0.11 then
				local alpha = math.clamp(age / 0.11, 0, 1)
				shoulderAngle, elbowAngle, envelope = draw * alpha, 105 * alpha, alpha
			elseif age < 0.2 then
				local alpha = (age - 0.11) / 0.09
				shoulderAngle, elbowAngle, envelope = draw + (95 - draw) * alpha, 105 * (1 - alpha), 1
			elseif age < 0.25 then shoulderAngle, elbowAngle, envelope = 95, 0, 1
			else
				local alpha = math.clamp((age - 0.25) / 0.17, 0, 1)
				shoulderAngle, elbowAngle, envelope = 95 * (1 - alpha), 0, 1 - alpha
			end
			local side = if punch.side == "right" then 1 else -1
			compose(arm.shoulder, CFrame.Angles(math.rad(shoulderAngle), 0, math.rad(side * 4) * envelope))
			compose(arm.elbow, CFrame.Angles(math.rad(elbowAngle), 0, 0))
			compose(arm.wrist, CFrame.Angles(math.rad(-8) * envelope, 0, 0))
			torsoPose = CFrame.Angles(0, math.rad(side * 8) * envelope, 0)
			local fist = fistPosition(arm)
			if fist and age >= 0.11 and age <= 0.27 then
				table.insert(punch.history, 1, fist)
				if #punch.history > 5 then table.remove(punch.history) end
				for index, part in trail do
					local a, b = punch.history[index], punch.history[index + 1]
					if a and b and (a - b).Magnitude > 0.015 then
						part.Size = Vector3.new(0.08, 0.08, math.min((a - b).Magnitude, 2))
						part.CFrame, part.Transparency = CFrame.lookAt((a + b) / 2, a), 0.5 + index * 0.1
					else part.Transparency = 1 end
				end
			else hideTrail() end
			if punch.hit and not punch.impacted and age >= 0.18 then
				punch.impacted = true
				impact = { started = now, position = punch.target + Vector3.new(0, 0.7, 0) }
				damageText.Text, popup.Enabled = "-" .. tostring(punch.damage), true
			end
		end
		if dash then
			local strength = math.sin(math.clamp((now - dash.started) / dodgeDuration, 0, 1) * math.pi)
			local direction = root.CFrame:VectorToObjectSpace(dash.direction)
			local across = Vector3.new(-dash.direction.Z, 0, dash.direction.X)
			for index, part in wake do
				local position = root.Position - dash.direction * 1.6 + across * (if index == 1 then -1.15 else 1.15)
				part.CFrame = CFrame.lookAt(position, position + dash.direction)
				part.Size = Vector3.new(0.06, 0.06, 1 + strength * 4)
				part.Transparency = 0.9 - strength * 0.35
			end
			local lean = CFrame.new(0, -0.35 * strength, 0) * CFrame.Angles(direction.Z * math.rad(32) * strength, 0, -direction.X * math.rad(30) * strength)
			if rootJoint == torso then torsoPose = lean * torsoPose else compose(rootJoint, lean) end
			for _, side in { "right", "left" } do
				local sign = if side == "right" then 1 else -1
				local stride = math.sin((now - dash.started) / dodgeDuration * math.pi * 2) * sign * 24
				local leg, arm = legs[side], arms[side]
				compose(leg.hip, CFrame.Angles(math.rad(30 + stride) * strength, 0, 0))
				compose(leg.knee, CFrame.Angles(math.rad(-65) * strength, 0, 0))
				compose(leg.ankle, CFrame.Angles(math.rad(25) * strength, 0, 0))
				if not punch or punch.side ~= side then
					compose(arm.shoulder, CFrame.Angles(math.rad(-30) * strength, 0, math.rad(sign * 10) * strength))
					compose(arm.elbow, CFrame.Angles(math.rad(85) * strength, 0, 0))
				end
			end
		end
		if punch or dash then compose(torso, torsoPose) end
		if impact then
			local age = now - impact.started
			impactAnchor.CFrame = CFrame.new(impact.position + Vector3.new(0, age * 1.8, 0))
			damageText.TextTransparency = math.clamp((age - 0.35) / 0.25, 0, 1)
			for index, part in sparks do
				local angle = index * math.pi / 2
				part.CFrame = CFrame.new(impact.position + Vector3.new(math.cos(angle), math.sin(angle), 0) * (0.15 + age * 3)) * CFrame.Angles(0, 0, angle)
				part.Transparency = math.clamp(0.3 + age * 3, 0, 1)
			end
			if age >= 0.6 then impact = nil; hideImpact() end
		end
	end
	-- PreAnimation restores the previous cosmetic layer before Animator runs.
	-- PreSimulation then applies the fresh pose to BOTH supported joint types.
	local beforeAnimation = RunService.PreAnimation:Connect(restorePose)
	local poseConnection = RunService.PreSimulation:Connect(update)
	local function attackFx(target, hit, damage)
		if stopped or not rootPart() then return end
		hideTrail()
		punch = { started = os.clock(), side = if nextLeft then "left" else "right", history = {},
			hit = hit == true and finiteVector(target) and typeof(damage) == "number" and damage > 0 and damage < math.huge,
			target = target, damage = damage }
		nextLeft = not nextLeft
	end
	local function dodgeFx(direction)
		if stopped or not rootPart() or not finiteVector(direction) then return end
		local flat = direction * Vector3.new(1, 0, 1)
		if flat.Magnitude > 0.01 then dash = { started = os.clock(), direction = flat.Unit } end
	end
	local function cleanup()
		if stopped then return end
		stopped = true
		poseConnection:Disconnect(); beforeAnimation:Disconnect(); added:Disconnect(); removed:Disconnect()
		restorePose(); effects:Destroy()
		character = nil
	end
	return cleanup, attackFx, dodgeFx
end
return View
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="24">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="Gravity">196.2</float>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
  </Item>
</roblox>