    <Item class="Script" referent="9">
      <Properties>
        <string name="Name">WildbondServer</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!nonstrict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local shared = ReplicatedStorage:WaitForChild("Wildbond")
shared:SetAttribute("BuildVersion", "0.4.0")
local Expedition = require(shared:WaitForChild("Expedition"))
local CombatRules = require(shared:WaitForChild("CombatRules"))
local HuntMetrics = require(shared:WaitForChild("HuntMetrics"))
local Progression = require(shared:WaitForChild("Progression"))
local WorldBuilder = require(script:WaitForChild("WorldBuilder"))
local CombatService = require(script:WaitForChild("CombatService"))
local DodgeService = require(script:WaitForChild("DodgeService"))
local PetService = require(script:WaitForChild("PetService"))
local world = WorldBuilder.build()

local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
remotes.Parent = shared
local command = Instance.new("RemoteEvent")
command.Name = "Command"
command.Parent = remotes
local update = Instance.new("RemoteEvent")
update.Name = "Update"
update.Parent = remotes
local effect = Instance.new("RemoteEvent")
effect.Name = "Effect"
effect.Parent = remotes

-- This alpha deliberately keeps session data in memory. No Robux purchases exist.
local sessions = {}
local measurements = {}
local profiles = {}
local lastCommand = {}
local lastPrompt = {}
local actionIntervals = { sync = 1, attack = 0.1, bond = 0.1, dodge = 0.1, unlock = 0.25, equip = 0.25 }

local function send(player, message, success)
	local state = sessions[player]
	if not state or player.Parent ~= Players then
		return
	end
	player:SetAttribute("CompanionId", state.equipped)
	local snapshot = Expedition.snapshot(state)
	snapshot.timing = HuntMetrics.snapshot(measurements[player], os.clock())
	snapshot.progression = Progression.snapshot(profiles[player])
	update:FireClient(player, snapshot, message, success)
end

local combat = CombatService.start(function(player)
	return sessions[player]
end, function(player, id)
	local state = sessions[player]
	if state then
		local success, message = Expedition.defeat(state, id)
		send(player, message, success)
	end
end, function(player, targetPosition)
	effect:FireClient(player, "bond", targetPosition)
end, function(player, definition)
	local profile = profiles[player]
	if not profile or player.Parent ~= Players then return end
	local gained = Progression.award(profile, definition)
	if gained == nil then return end
	local reward = Progression.rewards[definition.kind]
	local message = string.format("+%d coins · +%d XP", reward.coins, reward.xp)
	if gained > 0 then message ..= string.format(" · Level %d!", profile.level) end
	send(player, message, true)
end)
local companions = PetService.start(function(player)
	return sessions[player]
end, combat, function(player, targetPosition)
	effect:FireClient(player, "bond", targetPosition)
end)
local dodging = DodgeService.start()

local function addPlayer(player)
	if sessions[player] then
		return
	end
	sessions[player] = Expedition.new()
	measurements[player] = HuntMetrics.new()
	profiles[player] = Progression.new()
	player:SetAttribute("CompanionId", "mosswolf")
	local function characterAdded(character)
		local humanoid = character:WaitForChild("Humanoid", 10)
		if humanoid then
			humanoid.MaxHealth = CombatRules.playerMaxHealth
			humanoid.Health = humanoid.MaxHealth
			humanoid.Died:Once(function()
				if measurements[player] then
					HuntMetrics.death(measurements[player])
				end
				send(player, "Take a breath. Your hunt progress stays when you respawn.", false)
			end)
		end
	end
	player.CharacterAdded:Connect(characterAdded)
	if player.Character then
		task.spawn(characterAdded, player.Character)
	end
end

Players.PlayerAdded:Connect(addPlayer)
Players.PlayerRemoving:Connect(function(player)
	sessions[player] = nil
	measurements[player] = nil
	profiles[player] = nil
	lastCommand[player] = nil
	lastPrompt[player] = nil
end)
for _, player in Players:GetPlayers() do
	addPlayer(player)
end

-- ProximityPrompt events still need server distance and alive checks.
for id, prompt in world.prompts do
	prompt.Triggered:Connect(function(player)
		local state = sessions[player]
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local landmark = prompt.Parent
		if not state or not root or not humanoid or humanoid.Health <= 0 or not landmark:IsA("BasePart") then
			return
		end
		if (root.Position - landmark.Position).Magnitude > 14 then
			return
		end
		local now = os.clock()
		if now - (lastPrompt[player] or -math.huge) < 0.25 then
			return
		end
		lastPrompt[player] = now
		local success, message
		if id == "start" then
			success, message = Expedition.start(state)
			if success then
				HuntMetrics.start(measurements[player], now)
				humanoid.Health = humanoid.MaxHealth
			end
		elseif id == "return" then
			success, message = Expedition.claim(state)
			if success then
				HuntMetrics.finish(measurements[player], now)
				humanoid.Health = humanoid.MaxHealth
				local duration = measurements[player].lastDuration or 0
				message = string.format("Hunt complete! +60 shells · %d:%02d · %d falls", math.floor(duration / 60), math.floor(duration % 60), measurements[player].lastDeaths or 0)
			end
		else
			success, message = Expedition.collect(state, id)
		end
		send(player, message, success)
	end)
end

command.OnServerEvent:Connect(function(player, action, payload)
	if typeof(action) ~= "string" or #action > 20 then
		return
	end
	local interval = actionIntervals[action]
	if not interval then return end
	local state = sessions[player]
	if not state then
		return
	end
	local now = os.clock()
	local history = lastCommand[player]
	if not history then
		history = {}
		lastCommand[player] = history
	end
	if now - (history[action] or -math.huge) < interval then
		return
	end
	history[action] = now
	if action == "sync" then
		send(player)
	elseif action == "attack" then
		local success, message, targetPosition, hit = combat.attack(player)
		if success and typeof(targetPosition) == "Vector3" then
			effect:FireClient(player, "melee", targetPosition, hit == true)
		end
		-- Quiet successful swings; keep mission text visible during combat.
		if not success and message ~= "Your next swing is not ready yet." then
			send(player, message, false)
		end
	elseif action == "bond" then
		local success, message = combat.bond(player)
		if not success then send(player, message, false) end
	elseif action == "dodge" then
		local success, message, direction = dodging.dodge(player, payload)
		if success then effect:FireClient(player, "dodge", direction)
		else send(player, message, false) end
	elseif action == "unlock" or action == "equip" then
		local petId = payload
		if typeof(petId) ~= "string" or #petId > 32 then
			return
		end
		local success, message = Expedition[action](state, petId)
		send(player, message, success)
	end
end)

game:BindToClose(function()
	companions.destroy()
	combat.destroy()
	dodging.destroy()
end)

print("Wildbond 0.4.0 ready: roaming foes, companion HP and automatic combat; purchases disabled.")
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">CombatService</string>
          <string name="Source"><![CDATA[--!strict
-- Guardians and combat decisions live on the server. The attack remote supplies no target.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Rules = require(ReplicatedStorage:WaitForChild("Wildbond"):WaitForChild("CombatRules"))

type HuntState = Rules.HuntState
type Definition = Rules.FoeDefinition
type Actor = { player: Player, character: Model, humanoid: Humanoid?, root: BasePart, pet: boolean?, life: number? }
type Slam = { center: Vector3, radius: number, resolveAt: number, disc: Part }
type Foe = {
	definition: Definition,
	model: Model,
	root: Part,
	health: number,
	maxHealth: number,
	alive: boolean,
	contributors: { [Player]: Model },
	participants: { [Player]: boolean },
	threatened: { [Player]: Model },
	participantCount: number,
	life: number,
	engaged: boolean,
	lastNearby: number,
	pattern: number,
	nextSlam: number,
	respawnAt: number?,
	slam: Slam?,
	transparencies: { [BasePart]: number },
	label: BillboardGui,
	healthText: TextLabel,
	healthFill: Frame,
	highlight: Highlight,
	flashUntil: number,
	home: Vector3,
	facing: Vector3,
	frames: { [BasePart]: CFrame },
	state: string,
	patrol: number,
	nextMelee: number,
	recoverUntil: number,
	melee: { target: Actor, resolveAt: number }?,
}

local CombatService = {}

local function point(position: Vector3): Rules.Point
	return { x = position.X, y = position.Y, z = position.Z }
end

local function actor(player: Player): Actor?
	if player.Parent ~= Players then
		return nil
	end
	local character = player.Character
	if not character or character.Parent == nil then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
		return nil
	end
	return { player = player, character = character, humanoid = humanoid, root = root }
end

local function setState(foe: Foe, state: string, at: number, duration: number?)
	if foe.state == state then return end
	foe.state = state
	foe.model:SetAttribute("State", state)
	foe.model:SetAttribute("ActionStartedAt", at)
	foe.model:SetAttribute("ActionDuration", duration or 0)
end

local function place(foe: Foe, position: Vector3, direction: Vector3)
	local flat = Vector3.new(direction.X, 0, direction.Z)
	if flat.Magnitude > 0.01 then foe.facing = flat.Unit end
	local frame = CFrame.new(position) * CFrame.Angles(0, math.atan2(foe.facing.X, foe.facing.Z), 0)
	for object, offset in foe.frames do
		object.CFrame = frame * offset
		object.Position = object.CFrame.Position -- Also keeps reflected/headless Instances consistent.
	end
	foe.model:SetAttribute("FacingDirection", foe.facing)
end

local function part(
	parent: Instance, name: string, size: Vector3, position: CFrame, color: Color3,
	shape: Enum.PartType?
): Part
	local object = Instance.new("Part")
	object.Name = name
	object.Anchored = true
	object.CanCollide = false
	object.CanTouch = false
	object.Size = size
	object.CFrame = position
	object.Color = color
	object.Material = Enum.Material.SmoothPlastic
	object.TopSurface = Enum.SurfaceType.Smooth
	object.BottomSurface = Enum.SurfaceType.Smooth
	if shape then
		object.Shape = shape
	end
	object.Parent = parent
	return object
end

local function buildFoe(parent: Instance, definition: Definition, now: number): Foe
	local model = Instance.new("Model")
	model.Name = definition.name
	model:SetAttribute("EnemyId", definition.id)
	model:SetAttribute("EnemyKind", definition.kind)
	model:SetAttribute("BountyTarget", definition.bounty)
	model:SetAttribute("Health", definition.maxHealth)
	model:SetAttribute("MaxHealth", definition.maxHealth)
	model:SetAttribute("Status", "Ready")
	model:SetAttribute("PartySize", 1)
	model.Parent = parent
	local spawn = definition.position
	local center = Vector3.new(spawn.x, spawn.y, spawn.z)
	model:SetAttribute("HomePosition", center)
	model:SetAttribute("State", "Patrol")
	model:SetAttribute("ActionStartedAt", now)
	model:SetAttribute("ActionDuration", 0)
	model:SetAttribute("FacingDirection", Vector3.new(0, 0, 1))
	local scale = if definition.boss then 1.4 else 1
	local bark = if definition.kind == "reed" then Color3.fromRGB(80, 115, 117) else Color3.fromRGB(108, 86, 63)
	local stone = if definition.boss then Color3.fromRGB(114, 119, 94) else Color3.fromRGB(143, 139, 112)
	local leaves = if definition.kind == "reed" then Color3.fromRGB(74, 181, 156) else Color3.fromRGB(120, 166, 76)
	local glow = if definition.boss then Color3.fromRGB(255, 174, 72) else Color3.fromRGB(171, 248, 164)
	local function shaped(name: string, size: Vector3, offset: Vector3, color: Color3, angles: Vector3?): Part
		local rotation = angles or Vector3.zero
		return part(model, name, size * scale, CFrame.new(center + offset * scale)
			* CFrame.Angles(math.rad(rotation.X), math.rad(rotation.Y), math.rad(rotation.Z)), color)
	end
	local boar = definition.kind == "boar"
	local reed = definition.kind == "reed"
	local body = shaped("BarkCore", if boar then Vector3.new(3.1, 2.3, 4.4)
		elseif reed then Vector3.new(2.4, 3.5, 2.1) else Vector3.new(3.1, 3.35, 2.5),
		Vector3.zero, bark, Vector3.new(0, 0, -3))
	body.CanCollide = true
	model.PrimaryPart = body
	if boar then
		local fur, snout = Color3.fromRGB(131, 89, 57), Color3.fromRGB(91, 61, 47)
		body.Color = fur
		shaped("Head", Vector3.new(2.5, 1.9, 2.2), Vector3.new(0, -0.2, 2.1), fur)
		shaped("Snout", Vector3.new(1.6, 1, 0.9), Vector3.new(0, -0.55, 3.52), snout)
		shaped("Ridge", Vector3.new(1.2, 0.6, 3.5), Vector3.new(0, 1.25, -0.3), snout)
		shaped("MossBack", Vector3.new(1.2, 0.3, 1.8), Vector3.new(-0.85, 1.15, -0.7), leaves)
		shaped("Tail", Vector3.new(0.3, 0.35, 1.4), Vector3.new(0, 0.05, -2.75), snout, Vector3.new(20, 0, 0))
		for _, side in { -1, 1 } do
			for _, endZ in { -1.3, 1.1 } do
				shaped("RootLeg", Vector3.new(0.75, 1.75, 0.85), Vector3.new(side * 1.12, -1.95, endZ), fur)
				shaped("RootFoot", Vector3.new(0.9, 0.45, 1.1), Vector3.new(side * 1.12, -2.72, endZ + 0.12), snout)
			end
			shaped("Ear", Vector3.new(0.65, 1, 0.5), Vector3.new(side * 0.95, 1.05, 2.15), fur, Vector3.new(0, 0, -side * 20))
			shaped("Eye", Vector3.new(0.22, 0.25, 0.22), Vector3.new(side * 1.23, 0.2, 2.75), Color3.fromRGB(248, 202, 94))
			shaped("Tusk", Vector3.new(0.28, 1.15, 0.3), Vector3.new(side * 0.9, -0.2, 3.4), Color3.fromRGB(236, 221, 180),
				Vector3.new(-20, 0, -side * 18))
		end
	else
		shaped("StoneApron", Vector3.new(2.7, 1.5, 0.6), Vector3.new(0, -0.65, 1.35), stone, Vector3.new(0, 0, 6))
		shaped("ChestRune", Vector3.new(0.45, 1.15, 0.14), Vector3.new(0, -0.25, 1.69), glow).Material = Enum.Material.Neon
		shaped("Head", Vector3.new(2.7, 1.9, 2.3), Vector3.new(0, 2.15, 0), stone, Vector3.new(0, 5, 2))
		for _, direction in { -1, 1 } do
			shaped("RootLeg", Vector3.new(1.15, 1.85, 1.3), Vector3.new(direction * 0.92, -2.05, 0), bark,
				Vector3.new(0, direction * 10, direction * 3))
			shaped("RootFoot", Vector3.new(1.5, 0.5, 1.85), Vector3.new(direction * 1.02, -2.77, 0.3), stone)
			shaped("BranchArm", Vector3.new(0.95, 2.6, 1.1), Vector3.new(direction * 2.02, -0.4, 0), bark,
				Vector3.new(0, 0, direction * 17))
			shaped("KnottedFist", Vector3.new(1.4, 1.15, 1.4), Vector3.new(direction * 2.4, -1.62, 0.15), stone,
				Vector3.new(0, direction * 14, direction * 8))
			shaped("Eye", Vector3.new(0.36, 0.32, 0.15), Vector3.new(direction * 0.64, 2.35, 1.2), glow).Material = Enum.Material.Neon
			shaped("TwigCrown", Vector3.new(0.33, 2.05, 0.4), Vector3.new(direction * 0.85, 3.48, -0.35), bark,
				Vector3.new(12, 0, -direction * 22))
			shaped("LeafCrown", if reed then Vector3.new(0.55, 2.6, 0.4) else Vector3.new(1.25, 0.62, 1.1),
				Vector3.new(direction * 1.3, 4.07, -0.4), leaves,
				Vector3.new(5, direction * 20, -direction * 12))
		end
		shaped("Brow", Vector3.new(2.35, 0.27, 0.33), Vector3.new(0, 2.64, 1.14), bark, Vector3.new(0, 0, 3))
		shaped("MossShoulder", Vector3.new(1.85, 0.65, 1.75), Vector3.new(-1.27, 1.68, -0.1), leaves,
			Vector3.new(0, -12, 9))
		if definition.boss then
			shaped("AncientCrest", Vector3.new(0.9, 1.3, 0.55), Vector3.new(0, 3.47, 0.2), glow,
				Vector3.new(0, 0, 45)).Material = Enum.Material.Neon
		end
	end

	local label = Instance.new("BillboardGui")
	label.Name = "GuardianHealth"
	label.Adornee = body
	label.Size = UDim2.fromOffset(220, 68)
	label.StudsOffsetWorldSpace = Vector3.new(0, (if boar then 3.5 else 6) * scale, 0)
	label.MaxDistance = 90
	label.AlwaysOnTop = true
	label.Parent = model
	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Size = UDim2.new(1, 0, 0, 28)
	title.Font = Enum.Font.GothamBold
	title.TextSize = if definition.boss then 19 else 17
	title.TextColor3 = Color3.fromRGB(255, 245, 219)
	title.TextStrokeTransparency = 0.35
	title.Text = definition.name
	title.Parent = label
	local track = Instance.new("Frame")
	track.Position = UDim2.fromOffset(15, 32)
	track.Size = UDim2.new(1, -30, 0, 10)
	track.BackgroundColor3 = Color3.fromRGB(30, 38, 35)
	track.BorderSizePixel = 0
	track.Parent = label
	local trackCorner = Instance.new("UICorner")
	trackCorner.CornerRadius = UDim.new(1, 0)
	trackCorner.Parent = track
	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = if definition.boss then Color3.fromRGB(240, 171, 70) else Color3.fromRGB(142, 203, 105)
	fill.BorderSizePixel = 0
	fill.Parent = track
	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(1, 0)
	fillCorner.Parent = fill
	local healthText = Instance.new("TextLabel")
	healthText.BackgroundTransparency = 1
	healthText.Position = UDim2.fromOffset(0, 46)
	healthText.Size = UDim2.new(1, 0, 0, 18)
	healthText.Font = Enum.Font.GothamMedium
	healthText.TextSize = 13
	healthText.TextColor3 = Color3.fromRGB(239, 242, 225)
	healthText.TextStrokeTransparency = 0.4
	healthText.Text = tostring(definition.maxHealth) .. " / " .. tostring(definition.maxHealth)
	healthText.Parent = label
	local highlight = Instance.new("Highlight")
	highlight.Name = "CombatSignal"
	highlight.Adornee = model
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.FillTransparency = 0.6
	highlight.OutlineTransparency = 0.2
	highlight.Enabled = false
	highlight.Parent = model
	local transparencies: { [BasePart]: number } = {}
	local frames: { [BasePart]: CFrame } = {}
	for _, object in model:GetDescendants() do
		if object:IsA("BasePart") then
			transparencies[object] = object.Transparency
			frames[object] = CFrame.new(center):ToObjectSpace(object.CFrame)
		end
	end
	return {
		definition = definition, model = model, root = body, health = definition.maxHealth,
		maxHealth = definition.maxHealth, alive = true, contributors = {}, participants = {}, threatened = {}, participantCount = 0, life = 1,
		engaged = false, lastNearby = now, pattern = 0, nextSlam = math.huge,
		respawnAt = nil, slam = nil, transparencies = transparencies,
		label = label, healthText = healthText, healthFill = fill, highlight = highlight, flashUntil = 0,
		home = center, facing = Vector3.new(0, 0, 1), frames = frames, state = "Patrol", patrol = 0,
		nextMelee = now, recoverUntil = now, melee = nil,
	}
end

local function healthDisplay(foe: Foe)
	foe.model:SetAttribute("Health", foe.health)
	foe.model:SetAttribute("MaxHealth", foe.maxHealth)
	foe.healthText.Text = tostring(foe.health) .. " / " .. tostring(foe.maxHealth)
	foe.healthFill.Size = UDim2.fromScale(foe.health / foe.maxHealth, 1)
end

local function clearSlam(foe: Foe)
	if foe.slam then
		foe.slam.disc:Destroy()
		foe.slam = nil
	end
end

local function visible(foe: Foe, enabled: boolean)
	for object, original in foe.transparencies do
		object.Transparency = if enabled then original else 1
		object.CanQuery = enabled
		object.CanCollide = enabled and object == foe.root
	end
	foe.label.Enabled = enabled
	foe.highlight.Enabled = false
end

local function lineOfSight(source: Actor, foe: Foe): boolean
	local parameters = RaycastParams.new()
	parameters.FilterType = Enum.RaycastFilterType.Exclude
	parameters.FilterDescendantsInstances = { source.character }
	if source.pet and source.player.Character then
		parameters.FilterDescendantsInstances = { source.character, source.player.Character }
	end
	parameters.RespectCanCollide = true
	local from = source.root.Position
	local result = Workspace:Raycast(from, foe.root.Position - from, parameters)
	return result == nil or result.Instance:IsDescendantOf(foe.model)
end

function CombatService.start(
	getState: (Player) -> HuntState?, onDefeat: (Player, string) -> (),
	onBondFx: ((Player, Vector3) -> ())?, onKill: ((Player, Definition) -> ())?
)
	local destroyed = false
	local folder = Instance.new("Folder")
	folder.Name = "WildbondGuardians"
	folder.Parent = Workspace
	local foes: { Foe } = {}
	local lastAttack: { [Player]: number } = {}
	local lastBond: { [Player]: number } = {}
	local combatUntil: { [Player]: number } = {}
	local companions: any = nil
	local function markCombat(player: Player, at: number)
		combatUntil[player] = at + 1.2
	end
	local function currentTarget(saved: Actor): Actor?
		if saved.pet then
			local current = companions and companions.actor(saved.player)
			return if current and current.character == saved.character and current.life == saved.life then current else nil
		end
		local current = actor(saved.player)
		return if current and current.character == saved.character then current else nil
	end
	local function takeDamage(source: Actor, amount: number, at: number)
		markCombat(source.player, at)
		if source.pet then
			if companions then companions.damage(source, amount, at) end
		elseif source.humanoid and Rules.canTakeDamage(at, source.character:GetAttribute("DodgeUntil")) then
			source.humanoid:TakeDamage(amount)
		end
	end
	local now = Workspace:GetServerTimeNow()
	for _, definition in Rules.foes do
		table.insert(foes, buildFoe(folder, definition, now))
	end

	local function defeat(foe: Foe, at: number)
		foe.alive = false
		foe.life += 1
		foe.respawnAt = at + Rules.respawnDelay
		clearSlam(foe) -- A killing blow during windup always cancels that slam.
		foe.melee = nil
		setState(foe, "Dead", at, 0.7)
		foe.model:SetAttribute("Status", "Returning")
		visible(foe, false)
		for player, character in foe.contributors do
			local source = actor(player)
			if source and source.character == character and Rules.eligible(getState(player), true, foe.definition.id)
				and Rules.inRange(point(source.root.Position), point(foe.root.Position), Rules.rewardRange) and onKill then
				onKill(player, foe.definition)
			end
			if source and source.character == character and Rules.canReward(getState(player), true, player.Parent == Players, true,
				foe.definition.id, point(source.root.Position), point(foe.root.Position)) then
				onDefeat(player, foe.definition.id)
			end
		end
		foe.contributors = {}
		foe.participants = {}
	end

	local function nearestPlayer(foe: Foe): Actor?
		local nearest: Actor? = nil
		local best = Rules.aggroRange * Rules.aggroRange
		for _, player in Players:GetPlayers() do
			local owner = actor(player)
			if not owner or not Rules.eligible(getState(player), true, foe.definition.id) then continue end
			local candidates = { owner }
			local companion = companions and companions.actor(player)
			if companion then table.insert(candidates, companion) end
			for _, source in candidates do
				if Rules.inRange(point(source.root.Position), point(foe.home), Rules.leashRadius) then
					local distance = Rules.distanceSquared(point(source.root.Position), point(foe.root.Position))
					if distance <= best and lineOfSight(source, foe) then nearest, best = source, distance end
				end
			end
		end
		return nearest
	end

	local function engage(foe: Foe, at: number)
		if foe.engaged then return end
		foe.engaged, foe.lastNearby = true, at
		foe.nextSlam = if foe.definition.boss then at + Rules.firstSlamDelay else math.huge
	end

	local function reset(foe: Foe, at: number)
		foe.life += 1
		foe.alive, foe.engaged = true, false
		foe.health, foe.maxHealth = foe.definition.maxHealth, foe.definition.maxHealth
		foe.contributors, foe.respawnAt, foe.flashUntil, foe.pattern = {}, nil, 0, 0
		foe.participants, foe.participantCount, foe.threatened = {}, 0, {}
		foe.lastNearby, foe.nextSlam = at, math.huge
		foe.melee, foe.nextMelee, foe.recoverUntil = nil, at, at
		place(foe, foe.home, Vector3.new(0, 0, 1))
		setState(foe, "Patrol", at)
		foe.model:SetAttribute("PartySize", 1)
		clearSlam(foe)
		foe.model:SetAttribute("Status", "Ready")
		healthDisplay(foe)
		visible(foe, true)
	end

	local function damage(foe: Foe, player: Player, source: Actor, amount: number, at: number)
		engage(foe, at)
		markCombat(player, at)
		foe.threatened[player] = source.character
		if not foe.participants[player] then
			foe.participants[player] = true
			foe.participantCount = math.min(foe.participantCount + 1, Rules.maxGroupSize)
			local maximum = Rules.scaledHealth(foe.definition.maxHealth, foe.participantCount)
			foe.health += maximum - foe.maxHealth
			foe.maxHealth = maximum
			foe.model:SetAttribute("PartySize", foe.participantCount)
		end
		foe.contributors[player] = source.character
		foe.health = math.max(0, foe.health - amount)
		foe.flashUntil = at + 0.15
		healthDisplay(foe)
		if foe.health <= 0 then defeat(foe, at) end
	end

	local function selectFoe(source: Actor, state: HuntState, radius: number): Foe?
		local selected: Foe? = nil
		local best = radius * radius
		for _, foe in foes do
			if foe.alive and foe.state ~= "Return" and Rules.eligible(state, true, foe.definition.id) then
				local distance = Rules.distanceSquared(point(source.root.Position), point(foe.root.Position))
				if distance <= best and lineOfSight(source, foe) then
					selected, best = foe, distance
				end
			end
		end
		return selected
	end

	local function beginSlam(foe: Foe, target: Actor, at: number)
		foe.pattern += 1
		local pattern = Rules.attackPattern(foe.definition, foe.pattern)
		local burst = pattern.centered
		local position = if burst then foe.root.Position else target.root.Position
		local center = Vector3.new(position.X, Rules.groundHeight, position.Z)
		local radius = pattern.radius
		local disc = part(folder, "SlamWarning", Vector3.new(0.12, radius * 2, radius * 2),
			CFrame.new(center) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(255, 80, 70), Enum.PartType.Cylinder)
		disc.Material = Enum.Material.Neon
		disc.Transparency = 0.45
		disc.CanQuery = false
		local sign = Instance.new("BillboardGui")
		sign.Size = UDim2.fromOffset(125, 26)
		sign.StudsOffsetWorldSpace = Vector3.new(0, 0.6, 0)
		sign.AlwaysOnTop = true
		sign.MaxDistance = 65
		sign.Parent = disc
		local text = Instance.new("TextLabel")
		text.Size = UDim2.fromScale(1, 1)
		text.BackgroundTransparency = 1
		text.Font = Enum.Font.GothamBold
		text.TextSize = 16
		text.TextColor3 = Color3.fromRGB(255, 239, 224)
		text.TextStrokeTransparency = 0.2
		text.Text = if burst then "RETREAT!" else "MOVE!"
		text.Parent = sign
		foe.slam = { center = center, radius = radius, resolveAt = at + pattern.windup, disc = disc }
		foe.model:SetAttribute("AttackTarget", target.root.Position)
		setState(foe, "SkillWindup", at, pattern.windup)
		foe.model:SetAttribute("Status", "Windup")
	end

	-- Short steering probes fit these flat clearings. Every candidate needs floor
	-- and a clear body-width corridor; walls and cliff edges stop movement.
	local function move(foe: Foe, goal: Vector3, speed: number, delta: number, players: { Player })
		local offset = Vector3.new(goal.X - foe.root.Position.X, 0, goal.Z - foe.root.Position.Z)
		if offset.Magnitude < 0.1 then return end
		local step = math.min(speed * delta, offset.Magnitude)
		local parameters = RaycastParams.new()
		parameters.FilterType = Enum.RaycastFilterType.Exclude
		local excluded: { Instance } = { folder }
		for _, player in players do if player.Character then table.insert(excluded, player.Character) end end
		parameters.FilterDescendantsInstances = excluded
		parameters.RespectCanCollide = true
		local width = if foe.definition.boss then 2.5 elseif foe.definition.kind == "boar" then 2.7 else 1.8
		for _, angle in { 0, 45, -45, 90, -90, 135, -135, 180 } do
			local direction = CFrame.Angles(0, math.rad(angle), 0):VectorToWorldSpace(offset.Unit)
			local position = foe.root.Position + direction * step
			local radius = if foe.state == "Patrol" then Rules.patrolRadius else Rules.leashRadius
			if not Rules.inRange(point(position), point(foe.home), radius) then continue end
			local side = Vector3.new(-direction.Z, 0, direction.X) * width
			local clear = true
			for _, sideOffset in { Vector3.zero, side, -side } do
				local from = foe.root.Position + sideOffset
				if Workspace:Raycast(from, direction * (step + width), parameters) then clear = false; break end
				local floor = Workspace:Raycast(position + sideOffset + Vector3.new(0, 2, 0), Vector3.new(0, -9, 0), parameters)
				if not floor or math.abs(floor.Position.Y - Rules.groundHeight) > 1.25 then clear = false; break end
			end
			if clear then place(foe, position, direction); return end
		end
	end

	local function beginMelee(foe: Foe, target: Actor, at: number)
		place(foe, foe.root.Position, target.root.Position - foe.root.Position)
		foe.melee = { target = target, resolveAt = at + Rules.enemyMeleeWindup }
		foe.nextMelee = at + (if foe.definition.boss then Rules.bossMeleeCooldown else Rules.enemyMeleeCooldown)
		foe.model:SetAttribute("AttackTarget", target.root.Position)
		setState(foe, "MeleeWindup", at, Rules.enemyMeleeWindup)
		foe.model:SetAttribute("Status", "Windup")
	end

	local function update(at: number, delta: number)
		if destroyed then
			return
		end
		local players = Players:GetPlayers()
		for _, foe in foes do
			if not foe.alive then
				if foe.respawnAt and at >= foe.respawnAt then
					reset(foe, at)
				end
				continue
			end
			if foe.state == "Return" then
				if (foe.root.Position - foe.home).Magnitude <= 0.8 then reset(foe, at)
				else move(foe, foe.home, Rules.chaseSpeed, delta, players) end
				continue
			end
			local nearest = nearestPlayer(foe)
			if nearest then
				engage(foe, at)
				foe.lastNearby = at
				local owner = actor(nearest.player)
				if owner then foe.threatened[nearest.player] = owner.character end
				markCombat(nearest.player, at)
			elseif foe.engaged and at >= foe.lastNearby + Rules.encounterResetDelay then
				clearSlam(foe)
				foe.melee = nil
				setState(foe, "Return", at)
				foe.model:SetAttribute("Status", "Returning")
				continue
			end
			local slam = foe.slam
			if slam and at >= slam.resolveAt then
				for _, player in players do
					local source = actor(player)
					if source and Rules.eligible(getState(player), true, foe.definition.id)
						and Rules.inSlam(point(source.root.Position), point(slam.center), slam.radius) and lineOfSight(source, foe) then
						takeDamage(source, foe.definition.slamDamage, at)
					end
					local pet = companions and companions.actor(player)
					if pet and source and Rules.eligible(getState(player), true, foe.definition.id)
						and Rules.inSlam(point(pet.root.Position), point(slam.center), slam.radius) and lineOfSight(pet, foe) then
						takeDamage(pet, foe.definition.slamDamage, at)
					end
				end
				clearSlam(foe)
				foe.nextSlam = at + Rules.slamCooldown
				foe.recoverUntil = at + Rules.enemyMeleeRecover
				setState(foe, "MeleeRecover", at, Rules.enemyMeleeRecover)
				foe.model:SetAttribute("Status", "Ready")
			end
			local melee = foe.melee
			if melee and at >= melee.resolveAt then
				local target = currentTarget(melee.target)
				if target and target.character == melee.target.character and Rules.eligible(getState(target.player), true, foe.definition.id)
					and Rules.inEnemyMelee(point(target.root.Position), point(foe.root.Position), point(foe.facing))
					and lineOfSight(target, foe) then takeDamage(target, foe.definition.meleeDamage, at) end
				foe.melee = nil
				foe.recoverUntil = at + Rules.enemyMeleeRecover
				setState(foe, "MeleeRecover", at, Rules.enemyMeleeRecover)
				foe.model:SetAttribute("Status", "Ready")
			end
			if not foe.slam and not foe.melee and at >= foe.recoverUntil then
				if nearest then
					if at >= foe.nextSlam then beginSlam(foe, nearest, at)
					elseif Rules.inRange(point(nearest.root.Position), point(foe.root.Position), Rules.enemyMeleeRange) then
						if at >= foe.nextMelee then beginMelee(foe, nearest, at) end
					else
						setState(foe, "Chase", at)
						move(foe, nearest.root.Position, Rules.chaseSpeed, delta, players)
					end
				else
					setState(foe, "Patrol", at)
					local phase = foe.patrol * 2.4 + foe.home.X
					local goal = foe.home + Vector3.new(math.sin(phase), 0, math.cos(phase)) * Rules.patrolRadius * 0.75
					if (foe.root.Position - goal).Magnitude < 0.6 then foe.patrol += 1 end
					move(foe, goal, Rules.patrolSpeed, delta, players)
				end
			end
			local flashing = at < foe.flashUntil
			foe.highlight.Enabled = flashing or foe.slam ~= nil or foe.melee ~= nil
			if flashing then
				foe.highlight.FillColor = Color3.fromRGB(255, 246, 221)
				foe.highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
			elseif foe.slam or foe.melee then
				foe.highlight.FillColor = Color3.fromRGB(255, 99, 55)
				foe.highlight.OutlineColor = Color3.fromRGB(255, 170, 75)
			end
		end
	end

	local accumulated = 0
	local heartbeat = RunService.Heartbeat:Connect(function(delta: number)
		accumulated += delta
		if accumulated >= 0.1 then
			local elapsed = math.min(accumulated, 0.2)
			accumulated = 0
			update(Workspace:GetServerTimeNow(), elapsed)
		end
	end)
	local leaving = Players.PlayerRemoving:Connect(function(player: Player)
		lastAttack[player] = nil
		lastBond[player] = nil
		combatUntil[player] = nil
		for _, foe in foes do
			foe.contributors[player] = nil
		end
	end)

	local service = {}
	function service.attack(player: Player): (boolean, string, Vector3?, boolean?)
		if destroyed then
			return false, "Combat is unavailable.", nil, nil
		end
		local source = actor(player)
		if not source then
			return false, "Wait until your character is ready.", nil, nil
		end
		local state = getState(player)
		local at = Workspace:GetServerTimeNow()
		if not Rules.cooldownReady(at, lastAttack[player], Rules.meleeCooldown) then
			return false, "Your next swing is not ready yet.", nil, nil
		end
		lastAttack[player] = at
		local ahead = source.root.Position + source.root.CFrame.LookVector * 6
		if not state then return true, "Practice swing.", ahead, false end
		local selected = selectFoe(source, state, Rules.meleeRange)
		if not selected then
			return true, if state.active then "Swing." else "Practice swing.", ahead, false
		end
		damage(selected, player, source, Rules.meleeDamage, at)
		if selected.health <= 0 then
			return true, selected.definition.name .. " defeated!", selected.root.Position, true
		end
		return true, selected.definition.name .. ": " .. tostring(selected.health) .. " HP", selected.root.Position, true
	end

	function service.cooldown(player: Player): number
		if companions then return companions.cooldown(player) end
		local previous = lastBond[player]
		return if previous then math.max(0, previous + Rules.petCooldown - Workspace:GetServerTimeNow()) else 0
	end

	function service.bond(player: Player): (boolean, string)
		if companions then return companions.skill(player) end
		if destroyed then return false, "Combat is unavailable." end
		local source, state = actor(player), getState(player)
		if not source then return false, "Wait until your character is ready." end
		if not state then return false, "Wait until your companion is ready." end
		if not Rules.canBond(state) then return false, "Equip a companion you own first." end
		local at = Workspace:GetServerTimeNow()
		if not Rules.cooldownReady(at, lastBond[player], Rules.petCooldown) then
			return false, "Your companion is catching its breath."
		end
		local selected = selectFoe(source, state, Rules.petRange)
		if not selected then return false, if state.active then "Move within 18 studs of an eligible creature."
			else "Move near a wild creature, or begin a hunt for bounty guardians." end
		lastBond[player] = at
		engage(selected, at)
		local life, character, equipped, defeated = selected.life, source.character, state.equipped, state.defeated
		local equipRevision = state.equipRevision
		task.delay(Rules.petWindup, function()
			if destroyed or not selected.alive or selected.life ~= life or selected.state == "Return" then return end
			local current, currentState = actor(player), getState(player)
			if not current or current.character ~= character or currentState ~= state
				or currentState.defeated ~= defeated or currentState.equipped ~= equipped or currentState.equipRevision ~= equipRevision
				or not Rules.canBond(currentState) or not Rules.eligible(currentState, true, selected.definition.id)
				or not Rules.inRange(point(current.root.Position), point(selected.root.Position), Rules.petRange)
				or not lineOfSight(current, selected) then return end
			damage(selected, player, current, Rules.petDamage, Workspace:GetServerTimeNow())
		end)
		if onBondFx then onBondFx(player, selected.root.Position) end
		return true, "Companion strike!"
	end


	-- Companion hooks use server-created actor roots. No remote supplies a target or damage.
	function service.attachCompanions(adapter: any)
		companions = adapter
	end

	function service.inCombat(player: Player): boolean
		local owner = actor(player)
		if destroyed or not owner then return false end
		for _, foe in foes do
			if foe.alive and foe.engaged and foe.state ~= "Return" and foe.threatened[player] == owner.character
				and Rules.inRange(point(owner.root.Position), point(foe.home), Rules.leashRadius)
				and Rules.inRange(point(owner.root.Position), point(foe.root.Position), Rules.aggroRange)
				and lineOfSight(owner, foe) then return true end
		end
		return Workspace:GetServerTimeNow() < (combatUntil[player] or -math.huge)
	end

	function service.selectCompanionTarget(player: Player, petRoot: BasePart, radius: number, provokedOnly: boolean): any
		local owner, state = actor(player), getState(player)
		if destroyed or not owner or not state then return nil end
		local selected, best = nil, radius * radius
		local source: Actor = { player = player, character = petRoot.Parent :: Model, root = petRoot, pet = true }
		for _, foe in foes do
			if not foe.alive or foe.state == "Return" or not Rules.eligible(state, true, foe.definition.id) then continue end
			if provokedOnly and (not foe.engaged or foe.threatened[player] ~= owner.character) then continue end
			if not Rules.inRange(point(owner.root.Position), point(foe.root.Position), companions.ownerLeash) then continue end
			local distance = Rules.distanceSquared(point(petRoot.Position), point(foe.root.Position))
			if distance <= best and lineOfSight(source, foe) then selected, best = foe, distance end
		end
		return if selected then { id = selected.definition.id, life = selected.life, model = selected.model, position = selected.root.Position } else nil
	end

	function service.engageCompanionTarget(player: Player, target: any)
		local owner = actor(player)
		if destroyed or not owner then return end
		for _, foe in foes do
			if foe.model == target.model and foe.life == target.life and foe.alive and foe.state ~= "Return" then
				local at = Workspace:GetServerTimeNow()
				engage(foe, at)
				foe.threatened[player] = owner.character
				markCombat(player, at)
			end
		end
	end

	function service.hitCompanionTarget(player: Player, petRoot: BasePart, target: any, amount: number, radius: number): boolean
		local owner, state = actor(player), getState(player)
		if destroyed or not owner or not state then return false end
		local pet = companions and companions.actor(player)
		if not pet or pet.root ~= petRoot then return false end
		for _, foe in foes do
			if foe.model == target.model and foe.life == target.life and foe.alive and foe.state ~= "Return"
				and Rules.eligible(state, true, foe.definition.id)
				and Rules.inRange(point(petRoot.Position), point(foe.root.Position), radius)
				and Rules.inRange(point(owner.root.Position), point(foe.root.Position), companions.ownerLeash) and lineOfSight(pet, foe) then
				damage(foe, player, owner, amount, Workspace:GetServerTimeNow())
				return true
			end
		end
		return false
	end

	function service.destroy()
		if destroyed then
			return
		end
		destroyed = true
		heartbeat:Disconnect()
		leaving:Disconnect()
		for _, foe in foes do
			clearSlam(foe)
			foe.contributors = {}
			foe.participants = {}
		end
		lastAttack = {}
		lastBond = {}
		folder:Destroy()
	end

	return service
end

return CombatService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">DodgeService</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Server-owned horizontal movement, collision checks and a short evade window.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Rules = require(ReplicatedStorage:WaitForChild("Wildbond"):WaitForChild("DodgeRules"))

local DodgeService = {}

function DodgeService.start()
	local active, lastDodge = {}, {}
	local destroyed = false
	local function finish(player)
		local dash = active[player]
		if not dash then return end
		active[player] = nil
		dash.character:SetAttribute("DodgeUntil", 0)
		if dash.humanoid.Parent then
			dash.humanoid.WalkSpeed = dash.walkSpeed
			dash.humanoid.AutoRotate = dash.autoRotate
		end
		if dash.root.Parent then
			pcall(function()
				if dash.wasAutomatic then dash.root:SetNetworkOwnershipAuto()
				else dash.root:SetNetworkOwner(dash.owner) end
			end)
		end
	end
	local heartbeat = RunService.Heartbeat:Connect(function(dt)
		local now = Workspace:GetServerTimeNow()
		for player, dash in active do
			if player.Parent ~= Players or player.Character ~= dash.character or not dash.root.Parent or dash.humanoid.Health <= 0 then
				finish(player)
				continue
			end
			local delta = math.min(dt, math.max(0, dash.endsAt - dash.lastStep))
			if now >= dash.endsAt then
				-- Do not stretch a dash over a stalled server frame.
				delta = math.min(delta, math.max(0, dash.endsAt - dash.lastStep))
			end
			local step = math.min(Rules.distance - dash.travelled, Rules.distance / Rules.duration * delta)
			-- Prevent inherited running momentum from adding distance to this move,
			-- while leaving the first tap's jump/gravity velocity intact.
			local velocity = dash.root.AssemblyLinearVelocity
			dash.root.AssemblyLinearVelocity = Vector3.new(0, velocity.Y, 0)
			while step > 0.0001 and active[player] == dash do
				local position = dash.root.CFrame.Position
				local segment = math.min(step, Rules.maxStepDistance)
				local safe = segment
				for _, height in { -1.5, 0, 1.5 } do
					local origin = position + Vector3.new(0, height, 0)
					local hit = Workspace:Raycast(origin, dash.direction * (segment + Rules.collisionMargin), dash.parameters)
					if hit then safe = math.min(safe, math.max(0, (hit.Position - origin).Magnitude - Rules.collisionMargin)) end
				end
				if safe <= 0.0001 then finish(player); break end
				local nextPosition = position + dash.direction * safe
				local floor = Workspace:Raycast(nextPosition + Vector3.new(0, 4, 0), Vector3.new(0, -24, 0), dash.parameters)
				if not floor or floor.Normal.Y < 0.55 or floor.Position.Y < position.Y - 12 then
					finish(player)
					break
				end
				dash.root.CFrame += dash.direction * safe
				dash.travelled += safe
				step -= safe
				if safe < segment - 0.0001 then finish(player); break end
			end
			if active[player] ~= dash then continue end
			dash.lastStep = math.min(now, dash.endsAt)
			if now >= dash.endsAt or dash.travelled >= Rules.distance then finish(player) end
		end
	end)
	local leaving = Players.PlayerRemoving:Connect(function(player)
		finish(player)
		lastDodge[player] = nil
	end)
	local service = {}
	function service.dodge(player, requestedDirection)
		if destroyed then return false, "Dodge is unavailable." end
		if player.Parent ~= Players or typeof(requestedDirection) ~= "Vector3" then return false, "Invalid dodge." end
		local direction = Rules.direction({ x = requestedDirection.X, y = requestedDirection.Y, z = requestedDirection.Z })
		if not direction then return false, "Invalid dodge direction." end
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not character or not root or not humanoid or humanoid.Health <= 0 or root.Anchored then
			return false, "Wait until your character is ready."
		end
		local now = Workspace:GetServerTimeNow()
		if active[player] or not Rules.ready(now, lastDodge[player]) then return false, "Your dodge is recovering." end
		local wasAutomatic, owner
		local acquired = pcall(function()
			wasAutomatic = root:GetNetworkOwnershipAuto()
			owner = root:GetNetworkOwner()
			root:SetNetworkOwner(nil)
		end)
		if not acquired then return false, "Your character cannot dodge yet." end
		local parameters = RaycastParams.new()
		parameters.FilterType = Enum.RaycastFilterType.Exclude
		parameters.FilterDescendantsInstances = { character }
		parameters.RespectCanCollide = true
		local vector = Vector3.new(direction.x, 0, direction.z)
		active[player] = {
			character = character, root = root, humanoid = humanoid, direction = vector,
			parameters = parameters, endsAt = now + Rules.duration, lastStep = now, travelled = 0,
			walkSpeed = humanoid.WalkSpeed, autoRotate = humanoid.AutoRotate, wasAutomatic = wasAutomatic, owner = owner,
		}
		lastDodge[player] = now
		humanoid.WalkSpeed, humanoid.AutoRotate = 0, false
		character:SetAttribute("DodgeUntil", now + Rules.invulnerabilityDuration)
		return true, "Dodge!", vector
	end
	function service.destroy()
		if destroyed then return end
		destroyed = true
		heartbeat:Disconnect()
		leaving:Disconnect()
		for player in active do finish(player) end
		table.clear(lastDodge)
	end
	return service
end

return DodgeService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">PetService</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Pet actors, health, movement, attacks and revival are authoritative server state.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Rules = require(ReplicatedStorage:WaitForChild("Wildbond"):WaitForChild("PetRules"))

local PetService = {}

local function ownerActor(player)
	if player.Parent ~= Players then return nil end
	local character = player.Character
	if not character or not character.Parent then return nil end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then return nil end
	return { character = character, root = root }
end

function PetService.start(getState, combat, onSkillFx)
	local folder = Instance.new("Folder")
	folder.Name, folder.Parent = "WildbondCompanions", Workspace
	local pets, destroyed = {}, false
	local function validPet(player)
		local state = getState(player)
		return state and state.owned and Rules.known(state.equipped) and state.owned[state.equipped] == true
	end
	local function setState(pet, state, at, duration)
		pet.state = state
		pet.model:SetAttribute("State", state)
		pet.model:SetAttribute("ActionStartedAt", at)
		pet.model:SetAttribute("ActionDuration", duration or 0)
		pet.player:SetAttribute("PetState", state)
	end
	local function publish(pet)
		pet.model:SetAttribute("Health", pet.health)
		pet.model:SetAttribute("MaxHealth", Rules.maxHealth)
		pet.model:SetAttribute("PetRespawnAt", pet.respawnAt or 0)
		pet.model:SetAttribute("PetSkillReadyAt", pet.nextSkill)
		pet.player:SetAttribute("PetHealth", pet.health)
		pet.player:SetAttribute("PetMaxHealth", Rules.maxHealth)
		pet.player:SetAttribute("PetRespawnAt", pet.respawnAt or 0)
		pet.player:SetAttribute("PetSkillReadyAt", pet.nextSkill)
	end
	local function create(player, owner, at)
		local model = Instance.new("Model")
		model.Name, model.Parent = "Companion_" .. tostring(player.UserId), folder
		model:SetAttribute("OwnerUserId", player.UserId)
		model:SetAttribute("PetId", getState(player).equipped)
		local root = Instance.new("Part")
		root.Name, root.Size = "Root", Vector3.new(1.7, 1.5, 2.7)
		root.Anchored, root.CanCollide, root.CanTouch, root.CanQuery = true, false, false, false
		root.Transparency, root.Parent = 1, model
		root.CFrame = owner.root.CFrame * CFrame.new(3.2, -1.5, 3.6)
		root.Position = root.CFrame.Position
		model.PrimaryPart = root
		local pet = { player = player, model = model, root = root, health = Rules.maxHealth,
			state = "Follow", life = 1, nextAttack = at, nextSkill = at, respawnAt = nil, pending = nil,
			equipped = getState(player).equipped, revision = getState(player).equipRevision }
		pets[player] = pet
		for key, value in { AttackDamage = Rules.attackDamage, SkillDamage = Rules.skillDamage,
			Defense = Rules.defense, MoveSpeed = Rules.moveSpeed } do
			model:SetAttribute(key, value)
			player:SetAttribute("Pet" .. key, value)
		end
		setState(pet, "Follow", at)
		publish(pet)
		return pet
	end
	local function groundPosition(pet, owner, position)
		local parameters = RaycastParams.new()
		parameters.FilterType = Enum.RaycastFilterType.Exclude
		local excluded = { folder, owner.character }
		local guardians = Workspace:FindFirstChild("WildbondGuardians")
		if guardians then table.insert(excluded, guardians) end
		for _, player in Players:GetPlayers() do
			if player.Character and player.Character ~= owner.character then table.insert(excluded, player.Character) end
		end
		parameters.FilterDescendantsInstances = excluded
		parameters.RespectCanCollide = true
		local floor = Workspace:Raycast(position + Vector3.new(0, 8, 0), Vector3.new(0, -28, 0), parameters)
		if not floor or floor.Normal and floor.Normal.Y < 0.55 then return nil end
		return Vector3.new(position.X, floor.Position.Y + 1.35, position.Z)
	end
	local function move(pet, owner, goal, delta, follow)
		local from = pet.root.Position
		local offset = Vector3.new(goal.X - from.X, 0, goal.Z - from.Z)
		if offset.Magnitude < 0.1 then
			local settled = groundPosition(pet, owner, from)
			if settled then
				pet.root.CFrame = CFrame.new(settled) * pet.root.CFrame.Rotation
				pet.root.Position = settled
			end
			return
		end
		local distance = math.min(offset.Magnitude, Rules.moveSpeed * math.min(delta, 0.2))
		-- Catch up after a real owner teleport/respawn without touching health or cooldown.
		if follow and offset.Magnitude > 40 then distance = offset.Magnitude end
		local nextPosition = groundPosition(pet, owner, from + offset.Unit * distance)
		if not nextPosition then return end
		local parameters = RaycastParams.new()
		parameters.FilterType = Enum.RaycastFilterType.Exclude
		parameters.FilterDescendantsInstances = { folder, owner.character, Workspace:FindFirstChild("WildbondGuardians") }
		parameters.RespectCanCollide = true
		if distance < 40 and Workspace:Raycast(from, offset.Unit * (distance + 0.8), parameters) then return end
		pet.root.CFrame = CFrame.lookAt(nextPosition, nextPosition + offset.Unit)
		pet.root.Position = nextPosition
	end
	local function begin(pet, owner, target, skill, at)
		if pet.pending or pet.health <= 0 then return false end
		if skill and at < pet.nextSkill or not skill and at < pet.nextAttack then return false end
		local duration = if skill then Rules.skillWindup else Rules.attackWindup
		if skill then pet.nextSkill = at + Rules.skillCooldown else pet.nextAttack = at + Rules.attackCooldown end
		pet.pending = { target = target, resolveAt = at + duration, skill = skill,
			character = owner.character, life = pet.life, revision = getState(pet.player).equipRevision,
			equipped = getState(pet.player).equipped }
		pet.model:SetAttribute("AttackTarget", target.position)
		setState(pet, if skill then "Skill" else "Attack", at, duration)
		combat.engageCompanionTarget(pet.player, target)
		if skill and onSkillFx then onSkillFx(pet.player, target.position) end
		publish(pet)
		return true
	end
	local service = { ownerLeash = Rules.ownerLeash }
	function service.actor(player)
		local pet = pets[player]
		if destroyed or not pet or pet.health <= 0 or not ownerActor(player) or not validPet(player) then return nil end
		return { player = player, character = pet.model, root = pet.root, pet = true, life = pet.life }
	end
	function service.damage(source, amount, at)
		local pet = pets[source.player]
		if destroyed or not pet or pet.model ~= source.character or pet.life ~= source.life or pet.health <= 0 then return end
		pet.health = math.max(0, pet.health - Rules.damageTaken(amount))
		if pet.health <= 0 then
			pet.life += 1
			pet.pending, pet.respawnAt = nil, nil
			setState(pet, "Dead", at, 0.65)
		end
		publish(pet)
	end
	function service.cooldown(player)
		local pet = pets[player]
		return if pet then math.max(0, pet.nextSkill - Workspace:GetServerTimeNow()) else 0
	end
	function service.skill(player)
		local owner, pet = ownerActor(player), pets[player]
		if destroyed or not owner or not validPet(player) then return false, "Wait until your companion is ready." end
		if not pet or pet.health <= 0 then return false, "Your companion will return after ten seconds out of combat." end
		local at = Workspace:GetServerTimeNow()
		if pet.pending or at < pet.nextSkill then return false, "Your companion is catching its breath." end
		local target = combat.selectCompanionTarget(player, pet.root, Rules.skillRange, false)
		if not target then return false, "Move your companion closer to an eligible creature." end
		begin(pet, owner, target, true, at)
		return true, "Companion skill!"
	end
	combat.attachCompanions(service)
	local function update(at, delta)
		for _, player in Players:GetPlayers() do
			local owner = ownerActor(player)
			local inCombat = combat.inCombat(player)
			player:SetAttribute("InCombat", inCombat)
			local pet = pets[player]
			if not pet and owner and validPet(player) then pet = create(player, owner, at) end
			if not pet then continue end
			local state = getState(player)
			if state and (state.equipped ~= pet.equipped or state.equipRevision ~= pet.revision) then
				pet.equipped, pet.revision, pet.pending = state.equipped, state.equipRevision, nil
				pet.life += 1
				pet.model:SetAttribute("PetId", state.equipped)
				if pet.health > 0 then setState(pet, "Follow", at) end
			end
			if pet.health <= 0 then
				if inCombat or not owner then pet.respawnAt = nil
				elseif not pet.respawnAt then pet.respawnAt = at + Rules.reviveDelay
				elseif at >= pet.respawnAt then
					pet.health, pet.life, pet.respawnAt = Rules.maxHealth, pet.life + 1, nil
					pet.nextAttack = math.max(pet.nextAttack, at + Rules.attackCooldown)
					pet.nextSkill = math.max(pet.nextSkill, at + Rules.skillCooldown)
					local position = groundPosition(pet, owner, owner.root.Position + Vector3.new(3.2, 0, 3.6))
					if position then pet.root.CFrame = CFrame.new(position); pet.root.Position = position end
					setState(pet, "Follow", at)
				end
				publish(pet)
				continue
			end
			if not owner or not validPet(player) then
				pet.pending = nil
				if pet.state ~= "Follow" then setState(pet, "Follow", at) end
				continue
			end
			local pending = pet.pending
			if pending then
				if pending.character ~= owner.character or pending.life ~= pet.life
					or pending.revision ~= state.equipRevision or pending.equipped ~= state.equipped then
					pet.pending = nil
					setState(pet, "Follow", at)
				elseif at >= pending.resolveAt then
					combat.hitCompanionTarget(player, pet.root, pending.target,
						if pending.skill then Rules.skillDamage else Rules.attackDamage,
						if pending.skill then Rules.skillRange else Rules.attackRange)
					pet.pending = nil
					setState(pet, "Follow", at)
				end
			end
			if pet.pending then continue end
			local target = if inCombat then combat.selectCompanionTarget(player, pet.root, Rules.ownerLeash, true) else nil
			if target then
				local distance = (target.position - pet.root.Position).Magnitude
				if at >= pet.nextSkill and distance <= Rules.skillRange then begin(pet, owner, target, true, at)
				elseif distance <= Rules.attackRange then begin(pet, owner, target, false, at)
				else move(pet, owner, target.position, delta, false) end
			else
				move(pet, owner, (owner.root.CFrame * CFrame.new(3.2, 0, 3.6)).Position, delta, true)
			end
		end
	end
	local accumulated = 0
	local heartbeat = RunService.Heartbeat:Connect(function(delta)
		if destroyed then return end
		accumulated += delta
		if accumulated < 0.1 then return end
		local elapsed = accumulated
		accumulated = 0
		update(Workspace:GetServerTimeNow(), elapsed)
	end)
	local removing = Players.PlayerRemoving:Connect(function(player)
		local pet = pets[player]
		if pet then pet.model:Destroy(); pets[player] = nil end
	end)
	function service.destroy()
		if destroyed then return end
		destroyed = true
		heartbeat:Disconnect()
		removing:Disconnect()
		combat.attachCompanions(nil)
		pets = {}
		folder:Destroy()
	end
	return service
end

return PetService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">WorldBuilder</string>
          <string name="Source"><![CDATA[--!strict
-- Greywater Reach is a connected woodland valley, built from original local geometry.
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CombatRules = require(ReplicatedStorage:WaitForChild("Wildbond"):WaitForChild("CombatRules"))

local WorldBuilder = {}

export type World = {
	prompts: { [string]: ProximityPrompt },
	companionSpawn: Vector3,
}

function WorldBuilder.build(): World
	local previous = workspace:FindFirstChild("FirstTrailIsland")
	if previous then
		previous:Destroy()
	end

	local world = Instance.new("Model")
	world.Name = "FirstTrailIsland"
	world.Parent = workspace
	-- Area grows by six, not distance by six. The first hunt stays in the core;
	-- the outer routes are additional hunting ground rather than a longer tutorial.
	local meadowWidth, meadowDepth = 550, 624
	local partCount = 0
	local prompts: { [string]: ProximityPrompt } = {}
	local palette = {
		grass = Color3.fromRGB(108, 157, 101),
		grassLight = Color3.fromRGB(133, 173, 112),
		earth = Color3.fromRGB(112, 91, 76),
		stone = Color3.fromRGB(124, 139, 135),
		stoneLight = Color3.fromRGB(160, 171, 158),
		path = Color3.fromRGB(196, 173, 125),
		wood = Color3.fromRGB(110, 77, 57),
		woodLight = Color3.fromRGB(163, 120, 77),
		cream = Color3.fromRGB(231, 217, 174),
		water = Color3.fromRGB(96, 190, 195),
		leaves = Color3.fromRGB(86, 132, 102),
		leavesLight = Color3.fromRGB(132, 168, 117),
		roof = Color3.fromRGB(66, 101, 111),
	}

	local function part(name: string, size: Vector3, frame: CFrame, color: Color3, material: Enum.Material?): Part
		local result = Instance.new("Part")
		result.Name = name
		result.Size = size
		result.CFrame = frame
		result.Color = color
		result.Material = material or Enum.Material.SmoothPlastic
		result.Anchored = true
		result.TopSurface = Enum.SurfaceType.Smooth
		result.BottomSurface = Enum.SurfaceType.Smooth
		result.Parent = world
		partCount += 1
		return result
	end

	local function label(adornee: BasePart, text: string, color: Color3?)
		local gui = Instance.new("BillboardGui")
		gui.Name = "LandmarkLabel"
		gui.Size = UDim2.fromOffset(210, 44)
		gui.StudsOffset = Vector3.new(0, 3.2, 0)
		gui.MaxDistance = 65
		gui.AlwaysOnTop = false
		gui.Parent = adornee
		local textLabel = Instance.new("TextLabel")
		textLabel.Size = UDim2.fromScale(1, 1)
		textLabel.BackgroundTransparency = 1
		textLabel.Font = Enum.Font.GothamMedium
		textLabel.TextSize = 19
		textLabel.TextColor3 = color or palette.cream
		textLabel.TextStrokeColor3 = Color3.fromRGB(44, 57, 52)
		textLabel.TextStrokeTransparency = 0.25
		textLabel.Text = text
		textLabel.Parent = gui
	end

	local function interaction(id: string, landmark: BasePart, action: string, object: string)
		landmark:SetAttribute("InteractionId", id)
		landmark:SetAttribute("InteractionRadius", 14)
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = id .. "Prompt"
		prompt.ActionText = action
		prompt.ObjectText = object
		prompt.KeyboardKeyCode = Enum.KeyCode.E
		prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
		prompt.HoldDuration = 0.35
		prompt.MaxActivationDistance = 14
		prompt.RequiresLineOfSight = false
		prompt.Exclusivity = Enum.ProximityPromptExclusivity.OneGlobally
		prompt.Parent = landmark
		prompts[id] = prompt
	end

	local function distanceToSegment(point: Vector3, a: Vector3, b: Vector3): number
		local line = b - a
		local along = math.clamp((point - a):Dot(line) / line:Dot(line), 0, 1)
		return (point - (a + line * along)).Magnitude
	end

	local sceneryRoutes: { { a: Vector3, b: Vector3, width: number } } = {}
	local regionLandmarks = {
		{ id = "westwood", title = "WESTWOOD HOLLOW", x = -154, z = 21, color = Color3.fromRGB(107, 145, 104) },
		{ id = "reedfen", title = "REEDFEN", x = -29, z = -294, color = Color3.fromRGB(143, 173, 141) },
		{ id = "oldwatch", title = "OLDWATCH RIDGE", x = 218, z = -191, color = Color3.fromRGB(137, 150, 143) },
		{ id = "sunmeadow", title = "SUNMEADOW", x = 85, z = 242, color = Color3.fromRGB(152, 177, 107) },
	}
	local function path(a: Vector3, b: Vector3, width: number, name: string?)
		local delta = b - a
		local middle = (a + b) / 2
		part(name or "Trail", Vector3.new(width, 0.12, delta.Magnitude + 1), CFrame.lookAt(middle, b), palette.path, Enum.Material.Sand)
		table.insert(sceneryRoutes, { a = a, b = b, width = width })
	end

	-- Keep the encounter floor level while the surrounding land reads as a valley.
	-- The broad landscape continues beyond the ridges; there is no ocean/island edge.
	part("WoodlandLandscape", Vector3.new(1800, 12, 1800), CFrame.new(8, -6, -29), palette.grass, Enum.Material.Grass)
	part("IslandEarth", Vector3.new(meadowWidth, 12, meadowDepth), CFrame.new(8, -4, -29), palette.earth, Enum.Material.Rock)
	part("IslandMeadow", Vector3.new(meadowWidth, 4, meadowDepth), CFrame.new(8, 2, -29), palette.grass, Enum.Material.Grass)

	local trailPoints = {
		Vector3.new(0, 4.07, 35),
		Vector3.new(0, 4.07, 15),
		Vector3.new(-45, 4.07, -25),
		Vector3.new(0, 4.07, -65),
		Vector3.new(65, 4.07, -80),
		Vector3.new(63, 4.07, -18),
		Vector3.new(35, 4.07, 35),
		Vector3.new(0, 4.07, 35),
	}
	for index = 1, #trailPoints - 1 do
		path(trailPoints[index], trailPoints[index + 1], 10)
	end
	path(Vector3.new(-23, 4.07, 27), Vector3.new(0, 4.07, 15), 7)
	path(Vector3.new(12, 4.07, 15), Vector3.new(0, 4.07, 15), 7)
	-- Short branches invite hunting beyond the expedition loop, without new boards.
	local sideTrails = {
		{ Vector3.new(-45, 4.07, -25), Vector3.new(-65, 4.07, -66) },
		{ Vector3.new(63, 4.07, -18), Vector3.new(70, 4.07, 33) },
	}
	for _, branch in sideTrails do
		path(branch[1], branch[2], 6, "SideTrail")
	end
	-- A continuous outer hunting circuit connects five visually distinct areas.
	-- Cross routes let players return to camp without walking the whole circuit.
	local outerPoints = {
		Vector3.new(-45, 4.07, -25), Vector3.new(-124, 4.07, -35),
		Vector3.new(-194, 4.07, -70), Vector3.new(-216, 4.07, -143),
		Vector3.new(-134, 4.07, -160), Vector3.new(-84, 4.07, -224),
		Vector3.new(-12, 4.07, -253), Vector3.new(77, 4.07, -245),
		Vector3.new(178, 4.07, -269), Vector3.new(187, 4.07, -198),
		Vector3.new(169, 4.07, -139), Vector3.new(227, 4.07, -70),
		Vector3.new(227, 4.07, 36), Vector3.new(188, 4.07, 132),
		Vector3.new(85, 4.07, 199), Vector3.new(-24, 4.07, 202),
		Vector3.new(-146, 4.07, 181), Vector3.new(-229, 4.07, 97),
		Vector3.new(-187, 4.07, 23), Vector3.new(-124, 4.07, -35),
	}
	for index = 1, #outerPoints - 1 do
		path(outerPoints[index], outerPoints[index + 1], 8, "OuterTrail")
	end
	local crossRoutes = {
		{ Vector3.new(0, 4.07, -65), Vector3.new(28, 4.07, -122) },
		{ Vector3.new(28, 4.07, -122), Vector3.new(16, 4.07, -171) },
		{ Vector3.new(16, 4.07, -171), Vector3.new(-12, 4.07, -253) },
		{ Vector3.new(65, 4.07, -80), Vector3.new(169, 4.07, -139) },
		{ Vector3.new(63, 4.07, -18), Vector3.new(227, 4.07, 36) },
		{ Vector3.new(0, 4.07, 35), Vector3.new(46, 4.07, 92) },
		{ Vector3.new(46, 4.07, 92), Vector3.new(85, 4.07, 199) },
		{ Vector3.new(-187, 4.07, 23), Vector3.new(-124, 4.07, 55) },
		{ Vector3.new(-124, 4.07, 55), Vector3.new(-146, 4.07, 181) },
	}
	for _, branch in crossRoutes do
		path(branch[1], branch[2], 7, "CrossTrail")
	end
	local landmarkRoutes = {
		{ Vector3.new(-187, 4.07, 23), Vector3.new(-154, 4.07, 9) },
		{ Vector3.new(-12, 4.07, -253), Vector3.new(-29, 4.07, -282) },
		{ Vector3.new(187, 4.07, -198), Vector3.new(205, 4.07, -191) },
		{ Vector3.new(85, 4.07, 199), Vector3.new(85, 4.07, 229) },
	}
	for _, branch in landmarkRoutes do
		path(branch[1], branch[2], 6, "LandmarkTrail")
	end

	-- The tavern has an actual doorway, a warm interior, and a readable silhouette.
	local tavernX, tavernZ = -24, 38
	part("TavernFloor", Vector3.new(21, 0.3, 19), CFrame.new(tavernX, 4.2, tavernZ), palette.woodLight, Enum.Material.WoodPlanks)
	part("TavernBackWall", Vector3.new(21, 8, 0.8), CFrame.new(tavernX, 8.4, tavernZ + 9), palette.cream)
	for _, side in { -1, 1 } do
		part("TavernSideWall", Vector3.new(0.8, 8, 18), CFrame.new(tavernX + side * 10, 8.4, tavernZ), palette.cream)
		part("DoorwayWall", Vector3.new(7.5, 8, 0.8), CFrame.new(tavernX + side * 6.4, 8.4, tavernZ - 9), palette.cream)
		part("RoofSlope", Vector3.new(12.2, 0.65, 22), CFrame.new(tavernX + side * 5.4, 14.2, tavernZ) * CFrame.Angles(0, 0, math.rad(-side * 23)), palette.roof)
		for _, endZ in { -9, 9 } do
			part("TavernPost", Vector3.new(1.1, 8.6, 1.1), CFrame.new(tavernX + side * 10, 8.4, tavernZ + endZ), palette.wood, Enum.Material.Wood)
		end
		part("WindowFrame", Vector3.new(4.1, 3.5, 0.25), CFrame.new(tavernX + side * 6.4, 9, tavernZ - 9.5), palette.wood)
		local window = part("WarmWindow", Vector3.new(3.2, 2.6, 0.15), CFrame.new(tavernX + side * 6.4, 9, tavernZ - 9.67), Color3.fromRGB(248, 202, 129), Enum.Material.Neon)
		window.CanCollide = false
		part("WindowCrossbar", Vector3.new(0.18, 2.7, 0.17), CFrame.new(tavernX + side * 6.4, 9, tavernZ - 9.8), palette.wood)
	end
	part("TavernDoorLintel", Vector3.new(5.5, 2.3, 1), CFrame.new(tavernX, 11.3, tavernZ - 9), palette.wood)
	part("TavernRoofRidge", Vector3.new(0.9, 0.9, 22.8), CFrame.new(tavernX, 16.6, tavernZ), palette.wood)
	part("Chimney", Vector3.new(2.6, 8.5, 2.5), CFrame.new(tavernX - 6, 14, tavernZ + 3), palette.stone, Enum.Material.Slate)
	part("TavernFrontBeam", Vector3.new(21, 0.6, 0.9), CFrame.new(tavernX, 12, tavernZ - 9.15), palette.wood)
	for _, side in { -1, 1 } do
		part("TavernFootBeam", Vector3.new(7.5, 0.6, 0.9), CFrame.new(tavernX + side * 6.4, 5, tavernZ - 9.15), palette.wood)
	end
	part("TavernTable", Vector3.new(5, 0.5, 3), CFrame.new(tavernX, 6.5, tavernZ + 2), palette.woodLight, Enum.Material.Wood)
	part("TablePedestal", Vector3.new(1, 2, 1), CFrame.new(tavernX, 5.3, tavernZ + 2), palette.wood)
	for _, side in { -1, 1 } do
		part("TavernBench", Vector3.new(5, 0.6, 1), CFrame.new(tavernX, 5.2, tavernZ + 2 + side * 2.3), palette.woodLight)
	end
	local tavernSign = part("TavernSign", Vector3.new(5.5, 1.7, 0.4), CFrame.new(tavernX, 10.8, tavernZ - 9.8), palette.wood)
	label(tavernSign, "THE WAYFARER", palette.cream)
	local regionSign = part("RegionSign", Vector3.new(7.8, 2.2, 0.4), CFrame.new(4, 7.8, 49), palette.woodLight, Enum.Material.Wood)
	for _, x in { 0.5, 7.5 } do
		part("RegionSignPost", Vector3.new(0.5, 4.3, 0.5), CFrame.new(x, 6.15, 49), palette.wood)
	end
	label(regionSign, "GREYWATER REACH")

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "VillageSpawn"
	spawn.Size = Vector3.new(7, 1, 7)
	spawn.Position = Vector3.new(0, 4.5, 35)
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Transparency = 1
	spawn.CanCollide = false
